<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure model layer: no UI, no GL. Its one third-party dependency is Clipper2 (Boost SL 1.0, D-007), a
    fully managed polygon library used behind IPolygonOps so the engine can still run headless.
    Version pinned from project.assets.json (D-028).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Throng.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="1.5.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Throng.Core.Tests" />
  </ItemGroup>

</Project>
