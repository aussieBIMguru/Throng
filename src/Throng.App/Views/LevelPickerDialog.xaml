<Window x:Class="Throng.App.Views.LevelPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        MinWidth="380"
        MaxWidth="560"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
        Themed level checklist for Edit ▸ Copy to Levels… (D-060). Borderless like ThrongDialog: the frame and
        title strip are drawn here; drag the title strip to move it. Check boxes are created in code-behind.
    -->
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <DockPanel>
            <Border x:Name="TitleStrip" DockPanel.Dock="Top" Background="{StaticResource PanelAltBrush}" Padding="14,6" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource GlyphFont}" FontSize="14" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" Text="&#xE8C8;" />
                    <TextBlock x:Name="TitleText" FontFamily="{DynamicResource RetroFont}" FontSize="20"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <DockPanel DockPanel.Dock="Bottom" Margin="14,4,14,14" LastChildFill="False">
                <Button x:Name="AllButton" DockPanel.Dock="Left" Content="ALL" MinWidth="60" FontFamily="{DynamicResource RetroFont}" FontSize="16" />
                <Button x:Name="NoneButton" DockPanel.Dock="Left" Content="NONE" MinWidth="60" Margin="8,0,0,0" FontFamily="{DynamicResource RetroFont}" FontSize="16" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="CANCEL" MinWidth="86" Margin="8,0,0,0" IsCancel="True" FontFamily="{DynamicResource RetroFont}" FontSize="16" />
                <Button x:Name="OkButton" DockPanel.Dock="Right" Content="COPY" MinWidth="86" IsDefault="True" FontFamily="{DynamicResource RetroFont}" FontSize="16" />
            </DockPanel>

            <StackPanel Margin="18,14,18,10">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10" />
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LevelList" />
                </ScrollViewer>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
