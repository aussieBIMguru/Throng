<Window x:Class="Throng.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Throng.App.Views"
        Title="{Binding WindowTitle}"
        Icon="/Assets/throng.ico"
        Width="1440"
        Height="880"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        Window-wide shortcuts. Editing shortcuts (R/P/C/W/T/O/V tools, Ctrl+C/X/V/D/A, Ctrl+Shift+V, Del, Esc,
        Enter, Backspace, Tab) are handled by the viewport when it has focus, so they never fire while typing in a field.
    -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding NewFromDemoCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F2" Command="{Binding PlanViewCommand}" />
        <KeyBinding Key="F3" Command="{Binding OrbitViewCommand}" />
        <KeyBinding Key="F4" Command="{Binding IsoViewCommand}" />
        <KeyBinding Key="F5" Command="{Binding JourneyViewCommand}" />
        <KeyBinding Key="Enter" Command="{Binding FinishJourneyPickCommand}" />
        <KeyBinding Key="Home" Command="{Binding ZoomExtentsCommand}" />
        <KeyBinding Key="F7" Command="{Binding ValidateCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- A distribution in a definition editor (round 017, D-289): type, its numbers, a small plot of the shape. -->
        <DataTemplate x:Key="DistributionEditorTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                <ComboBox ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind, Mode=TwoWay}"
                          ToolTip="The shape of the spread. Picking another keeps the middle and spread roughly." />
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Visibility="{Binding HasValue, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Value" />
                        <TextBox Text="{Binding Value, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasBounds, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Min" />
                        <TextBox Text="{Binding Min, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" Visibility="{Binding HasMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Likely" />
                        <TextBox Text="{Binding Path=Mode, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" Visibility="{Binding HasStdDev, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mean" />
                        <TextBox Text="{Binding Mean, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,0,0" Visibility="{Binding HasBounds, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Max" />
                        <TextBox Text="{Binding Max, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Visibility="{Binding HasStdDev, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Spread (sd)" />
                        <TextBox Text="{Binding StdDev, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasMeanOnly, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mean" />
                        <TextBox Text="{Binding Mean, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <views:DistributionPlot Height="64" Margin="0,6,0,0" Distribution="{Binding Current}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding SummaryText}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ===== Menu ===== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand}" />
                <MenuItem Header="New from _Demo">
                    <MenuItem Header="_Interchange station" InputGestureText="Ctrl+Shift+D" Command="{Binding NewFromDemoCommand}" />
                    <MenuItem Header="_Office tower" Command="{Binding NewOfficeTowerDemoCommand}" ToolTip="Ground lobby and ten floors served only by a four-car lift bank (up-peak morning)." />
                </MenuItem>
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="Export _PNG…" Command="{Binding ExportPngCommand}" ToolTip="The view at twice its size, with a legend and title block." />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="{Binding UndoHeader}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="{Binding RedoHeader}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding CutCommand}" />
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
                <MenuItem Header="_Paste in Place" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
                <MenuItem Header="D_uplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}" />
                <MenuItem Header="Copy to _Levels…" InputGestureText="Ctrl+Shift+V" Command="{Binding CopyToLevelsCommand}" />
                <MenuItem Header="_Delete" InputGestureText="Del" Command="{Binding DeleteCommand}" />
                <Separator />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Plan" InputGestureText="F2" Command="{Binding PlanViewCommand}" />
                <MenuItem Header="_3D Orbit" InputGestureText="F3" Command="{Binding OrbitViewCommand}" />
                <MenuItem Header="_Isometric" InputGestureText="F4" Command="{Binding IsoViewCommand}" ToolTip="2:1 isometric of every visible level; [ and ] turn it." />
                <Separator />
                <MenuItem Header="_Zoom Extents" InputGestureText="Home" Command="{Binding ZoomExtentsCommand}" />
                <Separator />
                <MenuItem Header="_Hide Selection" InputGestureText="H" Command="{Binding HideSelectionCommand}" />
                <MenuItem Header="_Isolate Selection" InputGestureText="I" Command="{Binding IsolateSelectionCommand}" />
                <MenuItem Header="_Reset View" InputGestureText="Esc" Command="{Binding ResetViewCommand}" />
            </MenuItem>
            <MenuItem Header="_Draw">
                <MenuItem Header="_Select" InputGestureText="V" Command="{Binding SetToolCommand}" CommandParameter="Select" />
                <Separator />
                <MenuItem Header="_Rectangle" InputGestureText="R" Command="{Binding SetToolCommand}" CommandParameter="Rectangle" />
                <MenuItem Header="_Polygon" InputGestureText="P" Command="{Binding SetToolCommand}" CommandParameter="Polygon" />
                <MenuItem Header="_Circle" InputGestureText="C" Command="{Binding SetToolCommand}" CommandParameter="Circle" />
                <MenuItem Header="_Wall" InputGestureText="W" Command="{Binding SetToolCommand}" CommandParameter="Wall" />
                <Separator />
                <MenuItem Header="Co_nnect (stair, escalator, ramp)" InputGestureText="T" Command="{Binding SetToolCommand}" CommandParameter="Connect" />
                <MenuItem Header="S_haft" InputGestureText="O" Command="{Binding SetToolCommand}" CommandParameter="Shaft" />
                <MenuItem Header="Place _device / travelator" InputGestureText="D" Command="{Binding SetToolCommand}" CommandParameter="Place" />
            </MenuItem>
            <MenuItem Header="_Study">
                <MenuItem Header="_Validate" InputGestureText="F7" Command="{Binding ValidateCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Throng" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- ===== Toolbar ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="6,5">
            <DockPanel>
                <!-- Brand block on the right. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0">
                    <Image Source="/Assets/throng-64.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="THRONG" FontFamily="{DynamicResource RetroFont}" FontSize="30" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="PEDESTRIAN FLOW LAB" FontFamily="{DynamicResource RetroFont}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="1,-4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE710;" Content="NEW" Command="{Binding NewCommand}" ToolTip="New study. A blank slate and a single ground level." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE8F1;" Content="DEMO" Command="{Binding NewFromDemoCommand}" ToolTip="Load the Interchange Station demo: three levels of commuters-to-be (Ctrl+Shift+D)." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE8E5;" Content="OPEN" Command="{Binding OpenCommand}" ToolTip="Open a .throng study." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE74E;" Content="SAVE" Command="{Binding SaveCommand}" ToolTip="Save the study. Your crowd thanks you." />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE7A7;" Content="UNDO" Command="{Binding UndoCommand}" ToolTip="Undo the last change." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE7A6;" Content="REDO" Command="{Binding RedoCommand}" ToolTip="Redo." />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Content="PLAN" Tag="&#xE80A;" Command="{Binding PlanViewCommand}" ToolTip="Plan view of the active level (F2). This is where you draw.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlanButtonLit}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="3D" Tag="&#xE81E;" Command="{Binding OrbitViewCommand}" ToolTip="3D orbit of every visible level (F3).">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrbitButtonLit}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="ISO" Tag="&#xE8A9;" Command="{Binding IsoViewCommand}" ToolTip="2:1 isometric of every visible level (F4). [ and ] turn it a quarter; STUDY ▸ VIEW cuts and explodes.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIsoButtonLit}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="JOURNEY" Tag="&#xE8AB;" Command="{Binding JourneyViewCommand}" ToolTip="The selected journey's graph (F5): Spawn, branches, merges and Sinks. Pick one in LIBRARY ▸ JOURNEYS.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJourneyView}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE740;" Content="FIT" Command="{Binding ZoomExtentsCommand}" ToolTip="Zoom extents (Home)." />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE73E;" Content="CHECK" Command="{Binding ValidateCommand}" ToolTip="CHECK the study (F7): every rule, routes and capacity, listed in the CHECK tab. Catches irrational setups before your agents do." />
                    <Border Style="{StaticResource ToolSeparator}" />

                    <!-- RUN (D-097, D-104, D-106): PLAY checks and compiles first; editing is locked until RESET. -->
                    <Button Style="{StaticResource ToolButton}" Tag="{Binding PlayGlyph}" Content="{Binding PlayText}" Command="{Binding PlayPauseCommand}"
                            ToolTip="Run or pause the study. The first PLAY checks it and builds the navigation; editing is locked until RESET." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE893;" Content="STEP" Command="{Binding StepCommand}" ToolTip="Pause and advance one 0.1 s step." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE72C;" Content="RESET" Command="{Binding ResetRunCommand}" ToolTip="End the run, clear the agents and unlock editing." />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="×½" IsChecked="{Binding IsSpeedHalf, Mode=TwoWay}" ToolTip="Half real time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="×1" IsChecked="{Binding IsSpeed1, Mode=TwoWay}" ToolTip="Real time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="×2" IsChecked="{Binding IsSpeed2, Mode=TwoWay}" ToolTip="Twice real time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="×4" IsChecked="{Binding IsSpeed4, Mode=TwoWay}" ToolTip="Four times real time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="×8" IsChecked="{Binding IsSpeed8, Mode=TwoWay}" ToolTip="Eight times real time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="MAX" IsChecked="{Binding IsSpeedMax, Mode=TwoWay}" ToolTip="As fast as the machine allows." />
                    </StackPanel>
                    <!-- COLOUR (D-146): profile colours or a stress ramp; works while paused. Stuck people always blink a red ring. -->
                    <Border Style="{StaticResource ToolSeparator}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="PROFILE" IsChecked="{Binding IsColourProfile, Mode=TwoWay}" ToolTip="Colour people by profile (commuter, luggage…)." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="STRESS" IsChecked="{Binding IsColourStress, Mode=TwoWay}"
                                      ToolTip="Colour people by stress: blue calm, yellow tense, red fed up. Builds after half their patience is spent held up below half speed." />
                    </StackPanel>
                    <!-- MAP (D-201): live heatmap on floors and stair flights while running; people are drawn smaller and dimmed over it. -->
                    <Border Style="{StaticResource ToolSeparator}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="NO MAP" IsChecked="{Binding IsHeatOff, Mode=TwoWay}" ToolTip="No heatmap." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="DENSITY" IsChecked="{Binding IsHeatDensity, Mode=TwoWay}"
                                      ToolTip="Live density: people per m², each person spread over 1 m and smoothed over about 5 s. Shows while running, in plan and 3D." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="LOS" IsChecked="{Binding IsHeatLos, Mode=TwoWay}"
                                      ToolTip="Fruin Level of Service, A free to F critical: stair table on flights, queuing table in queues and dwell zones, walkway table elsewhere. Escalators aren't mapped." />
                    </StackPanel>
                    <!-- RUN maps (D-216, D-217): gathered after the warm-up while running, kept until RESET. -->
                    <TextBlock Text="RUN" Margin="8,0,2,0" VerticalAlignment="Center" FontFamily="{DynamicResource RetroFont}" FontSize="15" Foreground="{StaticResource TextDimBrush}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="MAX" IsChecked="{Binding IsHeatMax, Mode=TwoWay}"
                                      ToolTip="Run map: the worst Level of Service each place reached after the warm-up (highest smoothed density, Fruin bands)." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="E+ TIME" IsChecked="{Binding IsHeatLosEOrWorse, Mode=TwoWay}"
                                      ToolTip="Run map: how long each place spent at Level of Service E or worse after the warm-up, by the table for that place." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="MEAN" IsChecked="{Binding IsHeatMean, Mode=TwoWay}"
                                      ToolTip="Run map: mean density after the warm-up, people per m²." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="TRAIL" IsChecked="{Binding IsHeatFootfall, Mode=TwoWay}"
                                      ToolTip="Run map: footfall, how many people walked over each place after the warm-up. Shows the routes people actually take." />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Draw strip: tools, new-shape kind, snaps (plan view, D-026) ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4"
                IsEnabled="{Binding IsEditable}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="DRAW" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE8B3;" Content="SELECT" IsChecked="{Binding IsSelectTool, Mode=TwoWay}" ToolTip="Select, box-select, move and reshape (V)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE739;" Content="RECT" IsChecked="{Binding IsRectangleTool, Mode=TwoWay}" ToolTip="Rectangle: two corners or a drag. Type W,H for an exact size (R)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE70F;" Content="POLY" IsChecked="{Binding IsPolygonTool, Mode=TwoWay}" ToolTip="Polygon: click points; Enter, double-click or the first point closes (P)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xEA3A;" Content="CIRCLE" IsChecked="{Binding IsCircleTool, Mode=TwoWay}" ToolTip="Circle: centre then radius. Stored as a polygon within 50 mm of true (C)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE76F;" Content="WALL" IsChecked="{Binding IsWallTool, Mode=TwoWay}" ToolTip="Wall: an open polyline with thickness. Enter or double-click finishes (W)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE70E;" Content="CONNECT" IsChecked="{Binding IsConnectTool, Mode=TwoWay}"
                              ToolTip="Stair, escalator or ramp to a level above: click the bottom landing, aim up the run, click. Tab flips a switchback (T)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE80F;" Content="SHAFT" IsChecked="{Binding IsShaftTool, Mode=TwoWay}"
                              ToolTip="Shaft, atrium or void through several levels: two corners or a drag. Set its base and top in SELECTION (O)." />

                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE8B7;" Content="PLACE" IsChecked="{Binding IsPlaceTool, Mode=TwoWay}"
                              ToolTip="Device or travelator from the library: click its position, aim the service side (travelator: the far end), click (D)." />

                <!-- PLACE options (D-090). -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlaceTool, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="PRESET" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <ComboBox Width="190" VerticalAlignment="Center" ItemsSource="{Binding PlacePresetOptions}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedPlacePreset, Mode=TwoWay}" ToolTip="Device or travelator preset. Double-clicking one in LIBRARY picks it too." />
                </StackPanel>

                <!-- CONNECT options: preset and target level (D-054). -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsConnectTool, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="PRESET" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <ComboBox Width="170" VerticalAlignment="Center" ItemsSource="{Binding ConnectPresetOptions}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedConnectPreset, Mode=TwoWay}" ToolTip="Stair, escalator or ramp preset. Double-clicking one in LIBRARY ▸ VERTICAL picks it too." />
                    <TextBlock Text="TO" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <ComboBox Width="150" VerticalAlignment="Center" ItemsSource="{Binding ConnectTargetOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding ConnectTargetLevelId, Mode=TwoWay}" ToolTip="Level the connector arrives at. It starts on the active level, so pick a level above." />
                </StackPanel>

                <TextBlock Text="AS" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                <ComboBox Width="104" VerticalAlignment="Center" ItemsSource="{Binding DrawKindOptions}" SelectedItem="{Binding DrawKind, Mode=TwoWay}"
                          ToolTip="What new rectangles, polygons and circles become. Walls are always walls." />

                <Border Width="1" Margin="12,4" Background="{StaticResource BorderBrush}" />

                <TextBlock Text="SNAP" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ToggleButton Style="{StaticResource ChipToggle}" Content="GRID" IsChecked="{Binding SnapGrid, Mode=TwoWay}" ToolTip="Snap to the grid step." />
                <ToggleButton Style="{StaticResource ChipToggle}" Content="END" IsChecked="{Binding SnapEndpoint, Mode=TwoWay}" ToolTip="Snap to vertices on this level and the level below." />
                <ToggleButton Style="{StaticResource ChipToggle}" Content="MID" IsChecked="{Binding SnapMidpoint, Mode=TwoWay}" ToolTip="Snap to edge midpoints." />
                <ToggleButton Style="{StaticResource ChipToggle}" Content="ORTHO" IsChecked="{Binding SnapOrtho, Mode=TwoWay}" ToolTip="Lock to horizontal/vertical when close. Hold Shift to force it." />
                <TextBlock Text="STEP" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                <TextBox Width="54" VerticalAlignment="Center" Text="{Binding GridStepM, Mode=TwoWay}" ToolTip="Grid snap step in metres." />
                <TextBlock Text="m" Style="{StaticResource DimDataText}" VerticalAlignment="Center" Margin="4,0,0,0" />

                <!-- Shown only while something is temporarily hidden (D-046). -->
                <Border Width="1" Margin="12,4" Background="{StaticResource BorderBrush}"
                        Visibility="{Binding HasHiddenRegions, Converter={StaticResource BoolToVis}}" />
                <Button Content="{Binding ResetViewText}" Command="{Binding ResetViewCommand}" Padding="8,1"
                        FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource OrangeBrush}"
                        BorderBrush="{StaticResource OrangeBrush}" Focusable="False" VerticalAlignment="Center"
                        Visibility="{Binding HasHiddenRegions, Converter={StaticResource BoolToVis}}"
                        ToolTip="Show everything temporarily hidden again (Esc with nothing selected)." />
            </WrapPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▸ " FontFamily="{DynamicResource RetroFont}" FontSize="17" Foreground="{StaticResource YellowBrush}" />
                    <TextBlock Text="{Binding Ticker}" FontFamily="{DynamicResource RetroFont}" FontSize="17" Foreground="{StaticResource YellowBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Text="{Binding SummaryText}" Style="{StaticResource DimDataText}"
                           Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="2" Margin="16,0,12,0" VerticalAlignment="Center" Text="{Binding RunStatusText}" FontFamily="{DynamicResource RetroFont}" FontSize="17"
                           Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsRunActive, Converter={StaticResource BoolToVis}}"
                           ToolTip="Speed · agents walking · emitted · arrived · mean journey time · in device queues · stressed (stress 0.5 or more) · gave up (patience ran out, left) · stuck (no progress for 30 s; removed after 120 s)." />
                <Border Grid.Column="3" Background="#06090F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,1">
                    <TextBlock Text="{Binding ClockText}" FontFamily="{DynamicResource RetroFont}" FontSize="20" Foreground="{StaticResource GreenBrush}" ToolTip="Study clock: the run's time of day while running, otherwise the start time." />
                </Border>
            </Grid>
        </Border>

        <!-- ===== Body: levels/library | viewport | properties ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="290" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <!-- Add above / below, delete (D-142, D-143); locked while a run is active. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,8,8,0" VerticalAlignment="Center" TextElement.FontSize="11" IsEnabled="{Binding IsEditable}">
                        <Button Padding="6,0" Margin="2,0" Content="+ ABOVE" Command="{Binding AddLevelAboveCommand}"
                                ToolTip="Add a level above the active one. Between two levels it goes at mid-height and nothing moves." />
                        <Button Padding="6,0" Margin="2,0" Content="+ BELOW" Command="{Binding AddLevelBelowCommand}"
                                ToolTip="Add a level below the active one. Between two levels it goes at mid-height and nothing moves." />
                        <Button Padding="6,0" Margin="2,0" Content="DELETE" Command="{Binding DeleteLevelCommand}"
                                ToolTip="Delete the active level and everything on it (asks first; undo brings it back)." />
                    </StackPanel>
                    <TextBlock Style="{StaticResource PanelHeader}" Text="LEVELS" />
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding ActiveLevel, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource EyeToggle}" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1" Style="{StaticResource LockToggle}" IsChecked="{Binding IsLocked, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource DimDataText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Library: category tabs + search over one filtered list (D-021, D-031). -->
                <TextBlock Grid.Row="2" Style="{StaticResource PanelHeader}" Text="LIBRARY" />
                <Grid Grid.Row="3" Margin="10,0,10,6">
                    <TextBox x:Name="LibrarySearch" Text="{Binding Library.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search every category by name, summary or description." />
                    <TextBlock Text="Search library…" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextDisabledBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ListBox Grid.Row="4" Margin="8,0,8,4" Style="{StaticResource TabStrip}"
                         ItemsSource="{Binding Library.Tabs}" SelectedItem="{Binding Library.SelectedTab, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource RetroFont}" FontSize="15" />
                                <TextBlock Text="{Binding CountText}" FontFamily="{DynamicResource RetroFont}" FontSize="13" Margin="4,1,0,0" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <!-- Locked while running, except JOURNEYS: a journey opens read-only with its run overlay (round 019). -->
                        <Style TargetType="ScrollViewer">
                            <Setter Property="IsEnabled" Value="{Binding IsEditable}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Library.IsJourneysTabSelected}" Value="True">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="10,2,6,8">
                        <TextBlock Text="{Binding Library.EmptyText}" Style="{StaticResource DimText}" Margin="0,4,0,0"
                                   Visibility="{Binding Library.IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Library.VisibleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" MouseLeftButtonDown="OnLibraryItemMouseDown" MouseMove="OnLibraryItemMouseMove" MouseRightButtonUp="OnLibraryItemRightClick">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#2622D3EE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ToolTip>
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" />
                                                <TextBlock Text="Double-click a device, stair, escalator, ramp or travelator to place it, or drag it onto the plan or into 3D. Click a device, profile or journey to see or edit it in SELECTION." Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid.ToolTip>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" Margin="0,3,8,0" VerticalAlignment="Top" Background="{Binding Swatch}" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" />
                                                <!-- MINE / DIFFERS (round 020, D-343), MODIFIED / YOURS / IMPORTED (round 017, D-287). -->
                                                <TextBlock Margin="6,0,0,0" Text="{Binding Note}" FontFamily="{DynamicResource RetroFont}" FontSize="13" Foreground="{StaticResource YellowBrush}"
                                                           VerticalAlignment="Center" Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Profile definitions and exchange (round 016 D-275, round 017 D-286): AGENTS tab only. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Library.SelectedTab.Label}" Value="AGENTS">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Padding="6,0" Margin="0,0,6,0" Content="NEW" Command="{Binding NewProfileDefinitionCommand}" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                    ToolTip="A new profile of your own in this study, opened in SELECTION." />
                            <Button Padding="6,0" Content="EXPORT…" Command="{Binding ExportProfileCommand}" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                    ToolTip="Write the clicked profile and the journeys it's used with to a .throngprofile file." />
                            <Button Margin="6,0,0,0" Padding="6,0" Content="IMPORT…" Command="{Binding ImportProfileCommand}" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                    ToolTip="Add a profile (and its journeys) from a .throngprofile file. Anything this study lacks: keep, map or drop." />
                        </StackPanel>

                        <!-- Device definitions and exchange (round 017, D-286, D-290): DEVICES tab only. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Library.SelectedTab.Label}" Value="DEVICES">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Padding="6,0" Content="NEW" Command="{Binding NewDeviceDefinitionCommand}" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                    ToolTip="A new device type of your own in this study, opened in SELECTION." />
                            <Button Margin="6,0,0,0" Padding="6,0" Content="EXPORT…" Command="{Binding ExportDeviceCommand}" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                    ToolTip="Write the clicked device definition to a .throngdevice file." />
                            <Button Margin="6,0,0,0" Padding="6,0" Content="IMPORT…" Command="{Binding ImportDeviceCommand}" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                    ToolTip="Add a device definition from a .throngdevice file. A type no journey here uses: keep it or use one the study has." />
                        </StackPanel>

                        <!-- Your library across studies (round 020, D-343, D-347): AGENTS, DEVICES and JOURNEYS tabs. -->
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Library.SelectedTab.Label}" Value="VERTICAL">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Library.SelectedTab.Label}" Value="LIFTS">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Library.SelectedTab.Label}" Value="SCHEDULES">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="MY LIBRARY" FontFamily="{DynamicResource RetroFont}" FontSize="15" Foreground="{StaticResource YellowBrush}"
                                       ToolTip="{Binding MyLibraryFolder}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Button Padding="6,0" Content="EXPORT…" Command="{Binding ExportMyLibraryCommand}" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                        ToolTip="Tick items from your library and write them to a .thronglib to share." />
                                <Button Margin="6,0,0,0" Padding="6,0" Content="IMPORT…" Command="{Binding ImportMyLibraryCommand}" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                        ToolTip="Add a .thronglib's items to your library. Items you already have differently: keep both, skip or replace." />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                       Text="SAVE TO MY LIBRARY on a profile, device or journey in SELECTION keeps it for every study. Right-click a MINE row to rename or delete it." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Viewport -->
            <views:ViewportView x:Name="Viewport" Grid.Column="2" />

            <!-- JOURNEY view (D-308, D-309, D-323–D-327): the selected journey's graph over the viewport, edited in place. -->
            <views:JourneyCanvas x:Name="JourneyGraphView" Grid.Column="2"
                                 Visibility="{Binding IsJourneyView, Converter={StaticResource BoolToVis}}"
                                 Journey="{Binding SelectedJourney.Journey}"
                                 Host="{Binding SelectedJourney}"
                                 Revision="{Binding SelectedJourney.Revision}"
                                 SelectedNodeId="{Binding SelectedJourney.SelectedNodeId, Mode=TwoWay}">
                <views:JourneyCanvas.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding CloseJourneyViewCommand}" />
                </views:JourneyCanvas.InputBindings>
            </views:JourneyCanvas>

            <!-- Heatmap legend (D-204): bottom right of the viewport while a map shows. -->
            <Border Grid.Column="2" Margin="0,0,14,14" Padding="8,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding ShowHeatLegend, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding HeatLegendTitle}" FontFamily="{DynamicResource RetroFont}" FontSize="15" Foreground="{StaticResource TextDimBrush}" />
                    <TextBlock Text="{Binding HeatLegendNote}" FontFamily="{DynamicResource RetroFont}" FontSize="13" Foreground="{StaticResource TextDimBrush}"
                               Visibility="{Binding HasHeatLegendNote, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding HeatLegend}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Border Width="14" Height="10" Background="{Binding Swatch}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" Margin="6,0,0,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Right panel: SELECTION / LEVEL / STUDY tabs (D-045). Selecting anything switches to SELECTION. -->
            <Grid Grid.Column="4" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox Margin="10,10,10,6" Style="{StaticResource TabStrip}"
                         ItemsSource="{Binding PropertiesTabs}" SelectedIndex="{Binding PropertiesTabIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{DynamicResource RetroFont}" FontSize="18" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                    <!-- VIEW (round 015, D-264-D-268): cutaway and explode for 3D and ISO. Outside the edit lock, so it
                         works while running; session only, never saved or undone. -->
                    <StackPanel Margin="12,0,12,6" Visibility="{Binding IsStudyTab, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Padding="6,0" Content="CLEAR" Command="{Binding ClearViewCommand}"
                                    FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="No clip, no section box, levels back at true elevation." />
                            <TextBlock Style="{StaticResource PanelHeader}" Text="VIEW" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Text="3D and ISO only (F3, F4). Not saved with the study; works while running."
                                   Visibility="{Binding IsPlanView, Converter={StaticResource BoolToVis}}" />
                        <StackPanel IsEnabled="{Binding IsViewControlsEnabled}">
                            <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,8,0,0" Content="Clip above a level" IsChecked="{Binding ClipEnabled, Mode=TwoWay}"
                                          ToolTip="Cut away everything above the chosen level (just under the floor above it)." />
                            <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Levels}" DisplayMemberPath="Name" SelectedItem="{Binding ClipLevel, Mode=TwoWay}"
                                      IsEnabled="{Binding ClipEnabled}" ToolTip="Levels above this one are cut away." />

                            <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,10,0,0" Content="Section box" IsChecked="{Binding SectionBoxEnabled, Mode=TwoWay}"
                                          ToolTip="Show only what's inside a box; the sliders move its sides across the whole study." />
                            <Grid Margin="0,4,0,0" IsEnabled="{Binding SectionBoxEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="W ▸ E" VerticalAlignment="Center" Margin="0" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BoxWest, Mode=TwoWay}" Margin="0,2,4,2" ToolTip="West side" />
                                <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding BoxEast, Mode=TwoWay}" Margin="4,2,0,2" ToolTip="East side" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="S ▸ N" VerticalAlignment="Center" Margin="0" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BoxSouth, Mode=TwoWay}" Margin="0,2,4,2" ToolTip="South side" />
                                <Slider Grid.Row="1" Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding BoxNorth, Mode=TwoWay}" Margin="4,2,0,2" ToolTip="North side" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="LOW ▸ HIGH" VerticalAlignment="Center" Margin="0" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BoxBottom, Mode=TwoWay}" Margin="0,2,4,2" ToolTip="Bottom" />
                                <Slider Grid.Row="2" Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding BoxTop, Mode=TwoWay}" Margin="4,2,0,2" ToolTip="Top" />
                            </Grid>

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ExplodeText}" Style="{StaticResource DimDataText}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Explode levels" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="2" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    Value="{Binding ExplodeM, Mode=TwoWay}"
                                    ToolTip="Extra height between levels. Stairs, shafts and lift cars stretch to bridge the gap." />
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="With the section box on, drag its square handles in 3D to move a side."
                                       Visibility="{Binding SectionBoxEnabled, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- VIEWS (D-276): saved with the study (v10); works in plan too, and while running. -->
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Padding="6,0" Content="SAVE VIEW" Command="{Binding SaveViewCommand}"
                                    FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Save the camera, mode, level, cutaway and explode under a name, in the study." />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Views" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource DimText}" Text="No saved views yet." Margin="0,4,0,0"
                                   Visibility="{Binding HasNoViews, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding ViewRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4,0,0" Padding="4,3" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Left" Padding="6,0" Margin="0,0,6,0" Content="GO" Command="{Binding RestoreCommand}" VerticalAlignment="Top"
                                                    FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Restore this view." />
                                            <Button DockPanel.Dock="Right" Padding="6,0" Margin="6,0,0,0" Content="DELETE" Command="{Binding DeleteCommand}" VerticalAlignment="Top"
                                                    FontFamily="{DynamicResource RetroFont}" FontSize="13" ToolTip="Delete this view (undoable)." />
                                            <StackPanel>
                                                <TextBox Text="{Binding Name, Mode=TwoWay}" ToolTip="Rename: type and leave the field." />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource DimDataText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Margin="0,0,0,12" IsEnabled="{Binding IsEditable}">

                        <!-- SELECTION -->
                        <StackPanel Visibility="{Binding IsSelectionTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="12,2,12,4" Style="{StaticResource DimText}" Text="{Binding SelectionText}" />
                            <Border Visibility="{Binding HasRegionSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedRegion}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Kind" />
                                    <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind, Mode=TwoWay}" IsEnabled="{Binding CanChangeKind}" />
                                    <StackPanel Visibility="{Binding IsZone, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Zone purpose" />
                                        <ComboBox ItemsSource="{Binding ZoneKindOptions}" SelectedItem="{Binding ZoneKind, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Speed factor (Slow zones)" />
                                        <TextBox Text="{Binding SpeedFactor, Mode=TwoWay}" />
                                    </StackPanel>

                                    <!-- Emission rules on spawn zones (D-096, D-099) -->
                                    <StackPanel Visibility="{Binding IsSpawn, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource PanelHeader}" Text="EMISSION RULES" Margin="0,14,0,2" />
                                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Text="No rules yet: this zone emits no one. Add one to send people to a sink."
                                                   Visibility="{Binding HasNoRules, Converter={StaticResource BoolToVis}}" />
                                        <ItemsControl ItemsSource="{Binding EmissionRules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,6,0,0" Padding="8,4,8,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="REMOVE" Command="{Binding RemoveCommand}" Padding="6,0"
                                                                        FontFamily="{DynamicResource RetroFont}" FontSize="14" ToolTip="Delete this rule." />
                                                                <TextBlock Text="{Binding Header}" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Mix (who, their journey and share)" />
                                                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Text="No mix lines: this rule emits no one."
                                                                       Visibility="{Binding HasNoLines, Converter={StaticResource BoolToVis}}" />
                                                            <ItemsControl ItemsSource="{Binding MixLines}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,4,0,0" Padding="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="56" />
                                                                                        <ColumnDefinition Width="44" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                                                              SelectedValue="{Binding ProfileId, Mode=TwoWay}" ToolTip="Agent profile." />
                                                                                    <TextBox Grid.Column="1" Margin="4,0,0,0" Text="{Binding Share, Mode=TwoWay}" ToolTip="Relative share of the rule's arrivals." />
                                                                                    <TextBlock Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource DimText}" Text="{Binding SharePercent}" VerticalAlignment="Center" />
                                                                                    <Button Grid.Column="3" Margin="4,0,0,0" Content="×" Command="{Binding RemoveCommand}" Padding="6,0" ToolTip="Remove this line." />
                                                                                </Grid>
                                                                                <ComboBox Margin="0,2,0,0" ItemsSource="{Binding JourneyOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                                                          SelectedValue="{Binding JourneyId, Mode=TwoWay}" ToolTip="The steps they work through before leaving (LIBRARY ▸ JOURNEYS)." />
                                                                                <TextBox Margin="0,2,0,0" Text="{Binding SpawnTagsText, Mode=TwoWay}"
                                                                                         ToolTip="Tags some of them start with, e.g. &quot;ticket 50%, vip&quot; (no % means everyone). Journey steps can need, skip on or grant tags." />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Content="ADD LINE" Command="{Binding AddLineCommand}"
                                                                    FontFamily="{DynamicResource RetroFont}" FontSize="14" ToolTip="Add a mix line: another profile or journey in this stream." />
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="People per minute" />
                                                            <TextBox Text="{Binding RatePerMinute, Mode=TwoWay}" />
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Spacing" />
                                                            <ComboBox ItemsSource="{Binding PatternOptions}" SelectedItem="{Binding Pattern, Mode=TwoWay}"
                                                                      ToolTip="Constant: evenly spaced. Poisson: random arrivals at the same average rate." />
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Rate curve" />
                                                            <ComboBox ItemsSource="{Binding CurveOptions}" SelectedItem="{Binding CurveName, Mode=TwoWay}"
                                                                      ToolTip="Scales the rate over the run: minutes from the start → multiplier, straight lines between points. Pick a preset, then edit its points." />
                                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding CurveSummary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            <StackPanel Visibility="{Binding HasCurve, Converter={StaticResource BoolToVis}}">
                                                                <Border Margin="0,4,0,0" HorizontalAlignment="Left" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="2">
                                                                    <Polyline Points="{Binding CurveSparkline}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="160" Height="28" />
                                                                </Border>
                                                                <Grid Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Style="{StaticResource DimText}" Text="Minute" />
                                                                    <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="× rate" Margin="4,0,0,0" />
                                                                </Grid>
                                                                <ItemsControl ItemsSource="{Binding CurvePoints}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBox Grid.Column="0" Text="{Binding Minute, Mode=TwoWay}" ToolTip="Minutes from the start of the run." />
                                                                                <TextBox Grid.Column="1" Margin="4,0,0,0" Text="{Binding Multiplier, Mode=TwoWay}" ToolTip="Multiplier on the rule's rate (1 = as entered, 0 = no one)." />
                                                                                <Button Grid.Column="2" Margin="4,0,0,0" Content="×" Command="{Binding RemoveCommand}" Padding="6,0" ToolTip="Remove this point." />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Content="ADD POINT" Command="{Binding AddPointCommand}"
                                                                    FontFamily="{DynamicResource RetroFont}" FontSize="14" ToolTip="Add a curve point 10 minutes after the last, at the same multiplier." />
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Going to" />
                                                            <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding DestinationMode, Mode=TwoWay}"
                                                                      ToolTip="NearestSink: the quickest sink (never this zone). ChosenSinks: the ticked sinks, picked by weight." />
                                                            <StackPanel Visibility="{Binding IsChosenSinks, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Sinks and weights" />
                                                                <TextBlock Style="{StaticResource DimText}" Text="There are no other sink zones." Visibility="{Binding HasNoSinks, Converter={StaticResource BoolToVis}}" />
                                                                <ItemsControl ItemsSource="{Binding Sinks}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <DockPanel Margin="0,2">
                                                                                <TextBox DockPanel.Dock="Right" Width="48" Text="{Binding Weight, Mode=TwoWay}" IsEnabled="{Binding IsOn}"
                                                                                         ToolTip="Relative weight: 2 is picked twice as often as 1." />
                                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center" />
                                                                            </DockPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="ADD RULE" Command="{Binding AddRuleCommand}"
                                                FontFamily="{DynamicResource RetroFont}" FontSize="16"
                                                ToolTip="Add a stream of people: 10 a minute, random arrivals, to the nearest sink." />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasHeight, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Height" />
                                        <ComboBox ItemsSource="{Binding HeightModeOptions}" SelectedItem="{Binding HeightMode, Mode=TwoWay}"
                                                  ToolTip="Fixed: metres above each level's floor. FullStorey: floor to the next level's floor (D-077)." />
                                        <StackPanel Visibility="{Binding IsFixedHeight, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Height (m)" />
                                            <TextBox Text="{Binding HeightM, Mode=TwoWay}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding StoreyHeightText}" Style="{StaticResource DimDataText}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Top level" />
                                        <ComboBox ItemsSource="{Binding TopLevelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TopLevelId, Mode=TwoWay}"
                                                  ToolTip="Spans from this level up to the chosen one. Fixed heights repeat on each level; full storey runs floor to floor (D-079)." />
                                        <StackPanel Visibility="{Binding HasLevelToggles, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="On these levels" />
                                            <ItemsControl ItemsSource="{Binding LevelToggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsWall, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Thickness (m)" />
                                        <TextBox Text="{Binding ThicknessM, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tag (Void = floor opening)" />
                                    <TextBox Text="{Binding Tag, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource DataText}" />
                                        <TextBlock Text="  ·  " Style="{StaticResource DimDataText}" />
                                        <TextBlock Text="{Binding VertexText}" Style="{StaticResource DimDataText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Connector (D-063) -->
                            <Border Visibility="{Binding HasConnectorSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedConnector}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Preset" />
                                    <TextBlock Text="{Binding PresetText}" Style="{StaticResource DataText}" />
                                    <StackPanel Visibility="{Binding ChangesLevel, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Bottom level" />
                                        <ComboBox ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BottomLevelId, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Top level" />
                                        <ComboBox ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TopLevelId, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsTravelator, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Belt length (m)" />
                                        <TextBox Text="{Binding RunLengthM, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Width (m)" />
                                    <TextBox Text="{Binding WidthM, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Direction" />
                                    <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding Direction, Mode=TwoWay}" />
                                    <StackPanel Visibility="{Binding CanChangeShape, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Shape" />
                                        <ComboBox ItemsSource="{Binding ShapeOptions}" SelectedItem="{Binding Shape, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsSwitchback, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Return run side (Tab flips)" />
                                        <ComboBox ItemsSource="{Binding SideOptions}" SelectedItem="{Binding ReturnSide, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Gap between runs (m)" />
                                        <TextBox Text="{Binding SwitchbackGapM, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowsPerLevelOption, Converter={StaticResource BoolToVis}}">
                                        <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,12,0,0" Content="One circuit per level" IsChecked="{Binding PerLevelCircuits, Mode=TwoWay}"
                                                      ToolTip="On: a stacked stair core, one switchback per storey at the same spot. Off: one long run from bottom to top (D-091)." />
                                        <StackPanel Visibility="{Binding HasExitToggles, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Exits at intermediate levels" />
                                            <ItemsControl ItemsSource="{Binding ExitToggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,12,0,0" Content="Staff only" IsChecked="{Binding StaffOnly, Mode=TwoWay}"
                                                  ToolTip="Public agents never use it; staff routes arrive in M3 (D-110)." />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Run angle (°)" />
                                    <TextBox Text="{Binding AngleDeg, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Opening clearance (m)" />
                                    <TextBox Text="{Binding ClearanceM, Mode=TwoWay}"
                                             ToolTip="Extra floor cut around the linked opening on the upper level, for a balustrade (D-065)." />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding LayoutText}" Style="{StaticResource DataText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RiseText}" Style="{StaticResource DimDataText}" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding PairText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Shaft (D-056) -->
                            <Border Visibility="{Binding HasShaftSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedShaft}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Base level" />
                                    <ComboBox ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BaseLevelId, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Top level" />
                                    <ComboBox ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TopLevelId, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tag (e.g. Lift, Atrium)" />
                                    <TextBox Text="{Binding Tag, Mode=TwoWay}" />
                                    <StackPanel Visibility="{Binding HasStopToggles, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lift stops here" />
                                        <ItemsControl ItemsSource="{Binding StopToggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding SizeText}" Style="{StaticResource DataText}" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                               Text="Cut from the walkable area of every level from base to top, including levels with no stop. Grips and edge arrows reshape it on any of those levels." />

                                    <!-- LIFT (round 013, D-236-D-244): a bank of cars from a preset, doors per level, dispatch. -->
                                    <TextBlock Style="{StaticResource PanelHeader}" Text="LIFT" Margin="0,14,0,0" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Lift preset" />
                                    <ComboBox ItemsSource="{Binding LiftPresetOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LiftPresetKey, Mode=TwoWay}"
                                              ToolTip="Put a lift bank in this shaft. It serves the levels ticked above; No lift removes it." />
                                    <StackPanel Visibility="{Binding HasLift, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Margin="0,4,0,0" Text="{Binding LiftPresetText}" Style="{StaticResource DataText}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lift name" />
                                        <TextBox Text="{Binding LiftName, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Cars" />
                                        <ComboBox ItemsSource="{Binding LiftCarOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LiftCars, Mode=TwoWay}"
                                                  ToolTip="Cars side by side along the front edge, sharing the landings." />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Front edge" />
                                        <ComboBox ItemsSource="{Binding LiftEdgeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LiftFrontEdge, Mode=TwoWay}"
                                                  ToolTip="The shaft edge with the front doors. Rear doors go on the edge most nearly opposite." />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Landing depth (m)" />
                                        <TextBox Text="{Binding LiftLandingDepthM, Mode=TwoWay}" ToolTip="How far in front of each door people gather to wait." />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Dispatch" />
                                        <ComboBox ItemsSource="{Binding LiftDispatchOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LiftDispatchMode, Mode=TwoWay}"
                                                  ToolTip="Collective: stops for calls on the way. Up-peak: back to the lobby when empty. Shuttle: only the lowest and highest levels." />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lobby (Up-peak)" />
                                        <ComboBox ItemsSource="{Binding LiftStopOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding LiftLobbyLevelId, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Schedule (from 24 h time)" />
                                        <ItemsControl ItemsSource="{Binding LiftScheduleRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="4,0" Content="✕" Command="{Binding RemoveCommand}" ToolTip="Remove this row." />
                                                        <TextBox DockPanel.Dock="Left" Width="56" Text="{Binding FromText, Mode=TwoWay}" />
                                                        <ComboBox Margin="4,0,0,0" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DispatchChoice, Mode=TwoWay}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="0,4,0,0" HorizontalAlignment="Left" Padding="6,0" Content="ADD ROW" Command="{Binding AddScheduleRowCommand}"
                                                FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Switch dispatch at a time of day (e.g. Up-peak 07:30, Collective 09:30)." />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Doors (front · rear)" />
                                        <ItemsControl ItemsSource="{Binding LiftDoorRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <ComboBox DockPanel.Dock="Right" Width="78" Margin="4,0,0,0" IsEnabled="{Binding HasRear}" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Rear, Mode=TwoWay}" ToolTip="Rear door" />
                                                        <ComboBox DockPanel.Dock="Right" Width="78" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Front, Mode=TwoWay}" ToolTip="Front door" />
                                                        <TextBlock Text="{Binding LevelName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Device (D-089) -->
                            <Border Visibility="{Binding HasDeviceSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedDevice}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Definition" />
                                    <TextBlock Text="{Binding PresetText}" Style="{StaticResource DataText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DefinitionText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                    <!-- Definitions (round 017, D-286, D-288): placed devices follow theirs; MAKE UNIQUE forks one. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="EDIT DEFINITION" Command="{Binding EditDefinitionCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Open the definition this device follows (service time, type tag, pass-through, colour) in SELECTION." />
                                        <Button Margin="6,0,0,0" Content="MAKE UNIQUE" Command="{Binding MakeUniqueCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Give this device its own copy of its definition, so editing it changes only this device." />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Width (m)" />
                                    <TextBox Text="{Binding WidthM, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Depth (m)" />
                                    <TextBox Text="{Binding DepthM, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Lanes / servers" />
                                    <TextBox Text="{Binding Lanes, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Service side faces (°)" />
                                    <TextBox Text="{Binding AngleDeg, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Height (m)" />
                                    <TextBox Text="{Binding HeightM, Mode=TwoWay}" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding FlowText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                    <!-- Accessible (D-213, D-223): preset default, per-device override. -->
                                    <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,12,0,0" Content="Accessible" IsChecked="{Binding Accessible, Mode=TwoWay}"
                                                  ToolTip="Wheelchair users use only accessible devices of a type where the level has one; everyone else avoids them unless they prefer them (luggage and the accessible gate)." />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding AccessibleText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />

                                    <!-- Queue (D-153, D-163, D-164) -->
                                    <TextBlock Style="{StaticResource PanelHeader}" Text="QUEUE" Margin="0,14,0,2" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Max queue per lane" />
                                    <TextBox Text="{Binding MaxQueue, Mode=TwoWay}" ToolTip="Longest line per lane or server, in people. A drawn snake holds this many per lane it feeds." />
                                    <StackPanel Visibility="{Binding IsPassThrough, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lane directions (both / front / back, one per lane)" />
                                        <TextBox Text="{Binding LaneDirectionsText, Mode=TwoWay}"
                                                 ToolTip="front = entered from the side the device faces; back = from the other side; both = either way, turning round when empty. e.g. back, back, front, front." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="DRAW QUEUE" Command="{Binding DrawQueueCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Draw the queue path from the service side, click by click; Enter or double-click finishes, Esc cancels. One shared snake feeds every lane." />
                                        <Button Margin="6,0,0,0" Content="CLEAR QUEUE" Command="{Binding ClearQueueCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding HasDrawnQueue, Converter={StaticResource BoolToVis}}" ToolTip="Back to the automatic lines." />
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding QueueText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                               Text="The faint dots in plan are where people stand in line." />
                                </StackPanel>
                            </Border>

                            <!-- Device definition from LIBRARY ▸ DEVICES or EDIT DEFINITION (round 017, D-286-D-289) -->
                            <Border Visibility="{Binding HasDeviceDefinitionSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedDeviceDefinition}">
                                    <TextBlock Style="{StaticResource PanelHeader}" Text="DEVICE DEFINITION" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MineText}" Foreground="{StaticResource YellowBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding HasMineText, Converter={StaticResource BoolToVis}}" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="DUPLICATE" Command="{Binding DuplicateCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Make a separate copy in this study (new name and key)." />
                                        <Button Content="RESET TO BUILT-IN" Command="{Binding ResetCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" ToolTip="Put the shipped values back (undoable)." />
                                        <Button Content="DELETE" Command="{Binding DeleteCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}" ToolTip="Delete it (only when nothing uses it)." />
                                        <Button Content="EXPORT…" Command="{Binding ExportCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Write it to a file another study can import." />
                                        <Button Content="PLACE" Command="{Binding PlaceCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding IsPoint, Converter={StaticResource BoolToVis}}" ToolTip="Start PLACE with this definition." />
                                        <Button Content="SAVE TO MY LIBRARY" Command="{Binding SaveToMineCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Keep this definition in your library for every study (asks before replacing yours)." />
                                        <Button Content="UPDATE FROM MY LIBRARY" Command="{Binding UpdateFromMineCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding DiffersFromMine, Converter={StaticResource BoolToVis}}" ToolTip="Take your library's version into this study (undoable)." />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                                    <TextBox Text="{Binding Description, Mode=TwoWay}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Colour (#RRGGBB)" />
                                    <TextBox Text="{Binding ColorHex, Mode=TwoWay}" />
                                    <StackPanel Visibility="{Binding IsPoint, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Type tag (journeys' device steps go to a type)" />
                                        <ComboBox IsEditable="True" ItemsSource="{Binding TypeTagOptions}" Text="{Binding TypeTag, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                  ToolTip="Gate, TicketMachine… Placed devices follow. A new tag makes a new type: add a journey step for it." />
                                        <ContentControl Margin="0,4,0,0" Content="{Binding ServiceTime}" ContentTemplate="{StaticResource DistributionEditorTemplate}" Focusable="False" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Lanes for new devices" />
                                                <TextBox Text="{Binding Servers, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Choice weight (s)" />
                                                <TextBox Text="{Binding ChoiceWeight, Mode=TwoWay}" ToolTip="Seconds of walking it's worth when people choose between devices of a type: + draws them, − puts them off." />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Width for new (m)" />
                                                <TextBox Text="{Binding WidthM, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Depth for new (m)" />
                                                <TextBox Text="{Binding DepthM, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,10,0,0" Content="Pass-through (people walk through it, like a gate)" IsChecked="{Binding PassThrough, Mode=TwoWay}" />
                                        <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,6,0,0" Content="Accessible" IsChecked="{Binding Accessible, Mode=TwoWay}"
                                                      ToolTip="The default for placed devices; each can still override it in SELECTION." />
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource DimText}" TextWrapping="Wrap" Text="An area preset: draw it as a zone. Only its name, description and colour are used."
                                               Visibility="{Binding IsArea, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding UsageText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Agent profile from LIBRARY ▸ AGENTS (round 017, D-286, D-287, D-289) -->
                            <Border Visibility="{Binding HasProfileDefinitionSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedProfileDefinition}">
                                    <TextBlock Style="{StaticResource PanelHeader}" Text="AGENT PROFILE" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MineText}" Foreground="{StaticResource YellowBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding HasMineText, Converter={StaticResource BoolToVis}}" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="DUPLICATE" Command="{Binding DuplicateCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Make a separate copy in this study (new name and key)." />
                                        <Button Content="RESET TO BUILT-IN" Command="{Binding ResetCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" ToolTip="Put the shipped values back (undoable)." />
                                        <Button Content="DELETE" Command="{Binding DeleteCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}" ToolTip="Delete it (only when nothing uses it)." />
                                        <Button Content="EXPORT…" Command="{Binding ExportCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Write it to a file another study can import." />
                                        <Button Content="SAVE TO MY LIBRARY" Command="{Binding SaveToMineCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Keep this profile (and its default journey) in your library for every study (asks before replacing yours)." />
                                        <Button Content="UPDATE FROM MY LIBRARY" Command="{Binding UpdateFromMineCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding DiffersFromMine, Converter={StaticResource BoolToVis}}" ToolTip="Take your library's version into this study (undoable)." />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                                    <TextBox Text="{Binding Description, Mode=TwoWay}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Colour (#RRGGBB)" />
                                    <TextBox Text="{Binding ColorHex, Mode=TwoWay}" />
                                    <StackPanel>
                                        <ContentControl Margin="0,4,0,0" Content="{Binding Speed}" ContentTemplate="{StaticResource DistributionEditorTemplate}" Focusable="False" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Body radius (m)" />
                                                <TextBox Text="{Binding RadiusM, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Height (m)" />
                                                <TextBox Text="{Binding HeightM, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Stair up speed (× flat)" />
                                                <TextBox Text="{Binding StairUpFactor, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Stair down speed (× flat)" />
                                                <TextBox Text="{Binding StairDownFactor, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Stair up effort" />
                                                <TextBox Text="{Binding StairUpEffort, Mode=TwoWay}" ToolTip="How much longer a climb feels than it takes in route choice (2 = a 10 s climb weighs like 20 s)." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Stair down effort" />
                                                <TextBox Text="{Binding StairDownEffort, Mode=TwoWay}" ToolTip="The same walking down." />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Patience (s)" />
                                                <TextBox Text="{Binding PatienceS, Mode=TwoWay}" ToolTip="Seconds in a queue before the step's give-up rule applies." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Decisiveness (0-1)" />
                                                <TextBox Text="{Binding Decisiveness, Mode=TwoWay}" ToolTip="0 = very random choices, 1 = always the lowest cost option." />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Lift preference (-1 to 1)" />
                                                <TextBox Text="{Binding LiftPreference, Mode=TwoWay}" ToolTip="-1 avoids lifts, +1 strongly prefers them." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Escalator preference (-1 to 1)" />
                                                <TextBox Text="{Binding MechanisedPreference, Mode=TwoWay}" ToolTip="-1 avoids escalators, travelators and lifts, +1 strongly prefers them." />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Sees crowds within (m)" />
                                                <TextBox Text="{Binding SightRadiusM, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Walks on escalators (0-1)" />
                                                <TextBox Text="{Binding EscalatorWalkProbability, Mode=TwoWay}" ToolTip="Chance of walking rather than standing on an escalator." />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Acceptable journey (s)" />
                                                <TextBox Text="{Binding AcceptableJourneyS, Mode=TwoWay}" ToolTip="RESULTS ▸ JOURNEYS counts journeys longer than this." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Crowd tolerance (0-1)" />
                                                <TextBox Text="{Binding DensityTolerance, Mode=TwoWay}" ToolTip="Tolerance of crowding before frustration builds." />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Default journey (mix lines set to &quot;(profile default)&quot;)" />
                                        <ComboBox ItemsSource="{Binding DefaultJourneyOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  SelectedValue="{Binding DefaultJourneyId, Mode=TwoWay}"
                                                  ToolTip="The journey this profile follows on any mix line whose journey is (profile default). A line can still pick its own." />
                                        <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,10,0,0" Content="Lifts and ramps only" IsChecked="{Binding LiftOnly, Mode=TwoWay}" />
                                        <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,6,0,0" Content="Needs accessible devices" IsChecked="{Binding NeedsAccessibleDevices, Mode=TwoWay}"
                                                      ToolTip="Uses only accessible devices of a type where the level has one (D-213)." />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Device preferences (seconds of walking a device is worth)" Margin="0,10,0,0" />
                                        <ItemsControl ItemsSource="{Binding Preferences}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox IsEditable="True" ItemsSource="{Binding TargetOptions}" Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                  ToolTip="A device type tag or a definition's key." />
                                                        <TextBox Grid.Column="1" Margin="4,0,0,0" Text="{Binding BonusS, Mode=TwoWay}" ToolTip="Seconds: + prefers it, − avoids it." />
                                                        <Button Grid.Column="2" Margin="4,0,0,0" Content="×" Command="{Binding RemoveCommand}" Padding="6,0" ToolTip="Remove this preference." />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="0,4,0,0" HorizontalAlignment="Left" Content="ADD PREFERENCE" Command="{Binding AddPreferenceCommand}"
                                                FontFamily="{DynamicResource RetroFont}" FontSize="14" ToolTip="Add a device this profile prefers or avoids." />
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding UsageText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Journey from LIBRARY ▸ JOURNEYS (D-154, D-161, D-162, D-165) -->
                            <Border Visibility="{Binding HasJourneySelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedJourney}">
                                    <TextBlock Style="{StaticResource PanelHeader}" Text="JOURNEY" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MineText}" Foreground="{StaticResource YellowBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding HasMineText, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="DUPLICATE" Command="{Binding DuplicateCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Make an editable copy in this study (new name and key)." />
                                        <Button Margin="6,0,0,0" Content="DELETE" Command="{Binding DeleteCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}" ToolTip="Delete this journey (only when no mix line or profile uses it)." />
                                        <Button Margin="6,0,0,0" Content="RESET TO BUILT-IN" Command="{Binding ResetCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" ToolTip="Put this built-in journey back as it ships (D-328). Undoable." />
                                    </StackPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="SAVE TO MY LIBRARY" Command="{Binding SaveToMineCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Keep this journey in your library for every study, picks included (asks before replacing yours)." />
                                        <Button Content="UPDATE FROM MY LIBRARY" Command="{Binding UpdateFromMineCommand}" Padding="6,0" Margin="0,0,6,4" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding DiffersFromMine, Converter={StaticResource BoolToVis}}" ToolTip="Take your library's version into this study (undoable)." />
                                    </WrapPanel>
                                    <StackPanel IsEnabled="{Binding IsEditable}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                                        <TextBox Text="{Binding Description, Mode=TwoWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="SHOW GRAPH" Command="{Binding ShowGraphCommand}" Padding="6,0"
                                            FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Open the JOURNEY view (F5): the graph from Spawn to its Sinks." />

                                    <!-- The node selected on the canvas (or in the list below), D-318–D-324 -->
                                    <Border Margin="0,8,0,0" Padding="6,4,6,6" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                            Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolToVis}}">
                                        <StackPanel DataContext="{Binding SelectedNode}">
                                            <StackPanel IsEnabled="{Binding IsEditable}">
                                                <TextBlock Text="{Binding KindText}" FontFamily="{DynamicResource RetroFont}" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Label (empty = described from its settings)" />
                                                <TextBox Text="{Binding Label, Mode=TwoWay}" />

                                                <StackPanel Visibility="{Binding IsSink, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="People leave" />
                                                    <ComboBox ItemsSource="{Binding SinkKindOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SinkKind, Mode=TwoWay}" />
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding TargetLabel}" />
                                                    <ComboBox IsEditable="True" ItemsSource="{Binding TargetOptions}" Text="{Binding TargetTag, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                              ToolTip="A device type tag (Gate…), a zone tag (Retail…), a train service tag, or a person tag." />
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding IsSetTag, Converter={StaticResource BoolToVis}}">
                                                    <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,8,0,0" Content="Remove the tag (instead of granting it)" IsChecked="{Binding RemoveTag, Mode=TwoWay}" />
                                                </StackPanel>

                                                <!-- Candidates: type / tag or a pick list with weights (D-318, D-321, D-324) -->
                                                <StackPanel Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Choose by" />
                                                    <ComboBox ItemsSource="{Binding ChooseByOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ChooseBy, Mode=TwoWay}" />
                                                    <TextBlock Margin="0,2,0,0" Text="{Binding ChooseByHint}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0" Text="{Binding TargetSummary}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="PICK IN PLAN" Command="{Binding PickInPlanCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="14"
                                                                ToolTip="Go to plan and click devices or zones to add or remove them; Enter or DONE comes back." />
                                                        <Button Margin="6,0,0,0" Content="DONE" Command="{Binding DonePickingCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="14"
                                                                Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}" ToolTip="Back to the graph (Enter)." />
                                                        <Button Margin="6,0,0,0" Content="USE TYPE / TAG" Command="{Binding ClearPicksCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="14"
                                                                ToolTip="Clear the pick list: every device of the type, or every zone with the tag." />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pick list (tick to use; weight for random by weight)" />
                                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding Candidates}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="54" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox IsChecked="{Binding IsPicked, Mode=TwoWay}" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" Margin="4,0">
                                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource DimText}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBox Grid.Column="2" Text="{Binding Weight, Mode=TwoWay}" IsEnabled="{Binding IsPicked}" VerticalAlignment="Center"
                                                                                 ToolTip="Weight (D-326): relative, e.g. 3 and 1 = 75 % / 25 %." />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding HasGrants, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Grants tag when done (empty = none)" />
                                                    <TextBox Text="{Binding GrantsTag, Mode=TwoWay}" />
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding IsDwell, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Dwell (s, e.g. 60 or 30-180)" />
                                                    <TextBox Text="{Binding DwellText, Mode=TwoWay}" />
                                                </StackPanel>

                                                <!-- Device behaviour (D-322) -->
                                                <StackPanel Visibility="{Binding IsDevice, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="If patience runs out in the queue" />
                                                    <ComboBox ItemsSource="{Binding GiveUpOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding OnGiveUp, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Patience (s; empty = the profile's)" />
                                                    <TextBox Text="{Binding PatienceText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Switching mid-queue" />
                                                    <ComboBox ItemsSource="{Binding BalkOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Balk, Mode=TwoWay}" />
                                                </StackPanel>

                                                <!-- Chance weights (D-305, D-326) -->
                                                <StackPanel Visibility="{Binding IsChance, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Weights, one per output (e.g. 3, 1, 1)" />
                                                    <TextBox Text="{Binding WeightsText, Mode=TwoWay}" />
                                                    <TextBlock Margin="0,2,0,0" Text="{Binding WeightsSummary}" Style="{StaticResource DimDataText}" />
                                                    <Button Margin="0,4,0,0" HorizontalAlignment="Left" Content="ADD OUTPUT" Command="{Binding AddOutputCommand}" Padding="6,0"
                                                            FontFamily="{DynamicResource RetroFont}" FontSize="14" ToolTip="One more output (up to 6), weight 1." />
                                                </StackPanel>

                                                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="DELETE NODE" Command="{Binding DeleteCommand}" Padding="6,0"
                                                        FontFamily="{DynamicResource RetroFont}" FontSize="14" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Delete this node and its wires (Del on the canvas)." />
                                            </StackPanel>

                                            <!-- RUN (round 019, D-336): readable while the run locks the settings above. -->
                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasRun, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="RUN" FontFamily="{DynamicResource RetroFont}" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding RunSummary}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                                <Grid Margin="0,4,0,0" Visibility="{Binding HasRunRows, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="44" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="CANDIDATE" Style="{StaticResource FieldLabel}" Margin="0" />
                                                    <TextBlock Grid.Column="1" Text="PEOPLE" Style="{StaticResource FieldLabel}" Margin="0" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="SHARE" Style="{StaticResource FieldLabel}" Margin="0" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="WAIT" Style="{StaticResource FieldLabel}" Margin="0" TextAlignment="Right" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding RunRows}" Visibility="{Binding HasRunRows, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="52" />
                                                                    <ColumnDefinition Width="44" />
                                                                    <ColumnDefinition Width="44" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource DataText}" TextAlignment="Right" />
                                                                <TextBlock Grid.Column="2" Text="{Binding ShareText}" Style="{StaticResource DataText}" TextAlignment="Right" />
                                                                <TextBlock Grid.Column="3" Text="{Binding WaitText}" Style="{StaticResource DataText}" TextAlignment="Right" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Nodes (from Spawn, in order)" />
                                    <ItemsControl ItemsSource="{Binding Nodes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,2,0,0" Padding="6,2" HorizontalContentAlignment="Left" Command="{Binding SelectCommand}"
                                                        ToolTip="Select this node (it lights up on the canvas).">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding KindText}" FontFamily="{DynamicResource RetroFont}" FontSize="13" Foreground="{StaticResource TextDimBrush}" />
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- What CHECK will say about the graph (D-302–D-306) -->
                                    <StackPanel Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Graph checks" />
                                        <ItemsControl ItemsSource="{Binding Problems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,2,0,0" Text="{Binding}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding Summary}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding UsageText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Underlay (D-083–D-085) -->
                            <Border Visibility="{Binding HasUnderlaySelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedUnderlay}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <Button Margin="0,10,0,0" Content="SET SCALE" Command="{Binding SetScaleCommand}" FontFamily="{DynamicResource RetroFont}" FontSize="16"
                                            ToolTip="Click two points on the image a known distance apart, then type that distance (D-084)." />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Width (m)" />
                                    <TextBox Text="{Binding WidthM, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Rotation (°)" />
                                    <TextBox Text="{Binding AngleDeg, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Opacity (0–1)" />
                                    <TextBox Text="{Binding Opacity, Mode=TwoWay}" />
                                    <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,12,0,0" Content="Locked" IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                                  ToolTip="Locked underlays can't be picked, moved or rotated, so you can draw over them." />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding ScaleText}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                               Text="Drag to move, round grip to rotate. Lock it once it lines up. Plan view only." />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="12,14,12,0" Style="{StaticResource DimText}"
                                       Text="H hides the selection, I isolates it; Esc with nothing selected shows everything again. Hiding is view-only. Ctrl+Shift+V copies the selection to other levels." />
                        </StackPanel>

                        <!-- LEVEL (visibility is the eye on each level row, D-050) -->
                        <StackPanel Visibility="{Binding IsLevelTab, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="12,0" DataContext="{Binding ActiveLevel}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Elevation (m)" />
                                <TextBox Text="{Binding ElevationM, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Floor-to-floor height (m)" />
                                <TextBox Text="{Binding HeightM, Mode=TwoWay}" />
                                <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,12,0,0" Content="Locked" IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                              ToolTip="Locked levels can't be selected or edited, but still give snap points." />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource DimDataText}" Text="{Binding Summary}" />
                            </StackPanel>
                            <TextBlock Margin="12,4,12,0" Style="{StaticResource DataText}" Foreground="{StaticResource GreenBrush}" Text="{Binding WalkableAreaText}"
                                       ToolTip="Union of walkable regions minus obstacles and walls; drawn as the green outline in plan." />

                            <!-- Underlays on this level (D-085) -->
                            <TextBlock Style="{StaticResource PanelHeader}" Text="UNDERLAYS" Margin="12,16,12,4" />
                            <ItemsControl Margin="12,0" ItemsSource="{Binding UnderlayRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Style="{StaticResource EyeToggle}" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <ToggleButton Grid.Column="1" Style="{StaticResource LockToggle}" IsChecked="{Binding IsLocked, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                            <Button Grid.Column="2" Margin="8,0,0,0" Padding="6,1" HorizontalContentAlignment="Left" Content="{Binding Name}" Command="{Binding SelectCommand}"
                                                    ToolTip="Select it (unlock it first if it's locked)." />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="12,2,12,0" Style="{StaticResource DimText}" Text="No underlays on this level."
                                       Visibility="{Binding HasNoUnderlays, Converter={StaticResource BoolToVis}}" />
                            <Button Margin="12,8,12,0" HorizontalAlignment="Left" Content="ADD IMAGE…" Command="{Binding AddUnderlayCommand}"
                                    FontFamily="{DynamicResource RetroFont}" FontSize="16"
                                    ToolTip="Add a PNG or JPEG plan to this level. It's stored inside the .throng file." />

                            <TextBlock Margin="12,14,12,0" Style="{StaticResource DimText}"
                                       Text="Show or hide a level with the eye on its row in LEVELS." />
                        </StackPanel>

                        <!-- STUDY -->
                        <StackPanel Visibility="{Binding IsStudyTab, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="12,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                <TextBox Text="{Binding StudyName, Mode=TwoWay}" />

                                <!-- RUN (D-103, D-105) -->
                                <TextBlock Style="{StaticResource PanelHeader}" Text="RUN" Margin="0,14,0,0" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Start time (24 h)" />
                                <TextBox Text="{Binding StartTimeText, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="End" />
                                <ComboBox ItemsSource="{Binding EndConditionOptions}" SelectedItem="{Binding EndCondition, Mode=TwoWay}"
                                          ToolTip="FixedDuration: pause at the end of the duration. Indefinite: run until you pause or reset." />
                                <StackPanel Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Duration (minutes)" />
                                    <TextBox Text="{Binding DurationMinutes, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Long wait (seconds)" />
                                <TextBox Text="{Binding LongWaitS, Mode=TwoWay}"
                                         ToolTip="RESULTS ▸ JOURNEYS counts people whose longest single queue wait was over this (D-231)." />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Random seed" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6,0" Content="RE-ROLL" Command="{Binding ReRollSeedCommand}"
                                            FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Pick a new random seed: same study, a different crowd." />
                                    <TextBox Text="{Binding Seed, Mode=TwoWay}" ToolTip="Same file + same seed = the same run." />
                                </DockPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Keep side" />
                                <ComboBox ItemsSource="{Binding KeepSideOptions}" SelectedItem="{Binding KeepSide, Mode=TwoWay}"
                                          ToolTip="Which side people drift to when meeting oncoming flows. Escalators: stand on this side, walk on the other." />
                                <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,12,0,0" Content="Colour-blind-safe heatmap" IsChecked="{Binding ColourBlindHeatmap, Mode=TwoWay}"
                                              ToolTip="Heatmaps in a purple-teal-yellow ramp that reads with any colour vision, instead of the classic green-to-red Fruin colours." />

                                <!-- TRAINS (D-184-D-187): door zones driven by a timetable. -->
                                <TextBlock Style="{StaticResource PanelHeader}" Text="TRAINS" Margin="0,14,0,0" />
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                           Text="Select door zones (sink or spawn/sink) in the plan, then ADD SERVICE. A door's emission rules say who gets off (their rates are relative shares); it only takes boarders while a train is in." />
                                <Button Margin="0,6,0,0" HorizontalAlignment="Left" Padding="6,0" Content="ADD SERVICE" Command="{Binding AddTrainServiceCommand}"
                                        FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="New train service whose doors are the selected sink zones." />
                                <ItemsControl ItemsSource="{Binding TrainServiceRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,8,0,0" Padding="6,4,6,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="DELETE" Command="{Binding DeleteCommand}" Padding="6,0"
                                                                FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Delete this train service." />
                                                        <TextBlock Text="{Binding Header}" Style="{StaticResource PanelHeader}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tag (Board train steps ask for it)" />
                                                    <TextBox Text="{Binding Tag, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Every (s)" />
                                                    <TextBox Text="{Binding HeadwayText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="First train at (s after the start)" />
                                                    <TextBox Text="{Binding OffsetText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Doors open (s)" />
                                                    <TextBox Text="{Binding DwellText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="People getting off per train" />
                                                    <TextBox Text="{Binding AlightText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Getting off takes (s)" />
                                                    <TextBox Text="{Binding AlightOverText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Places per train" />
                                                    <TextBox Text="{Binding CapacityText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Doors" />
                                                    <TextBlock Text="{Binding DoorsText}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                                    <Button Margin="0,4,0,0" HorizontalAlignment="Left" Padding="6,0" Content="SET DOORS" Command="{Binding SetDoorsCommand}"
                                                            FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Make the sink zones selected in the plan this service's doors." />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Train shape" />
                                                    <TextBlock Text="{Binding ShapeText}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Padding="6,0" Content="DRAW TRAIN" Command="{Binding DrawShapeCommand}"
                                                                FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Draw the train's outline with the polygon tool on the doors' level. The door zones stay the doors." />
                                                        <Button Margin="6,0,0,0" Padding="6,0" Content="AUTO" Command="{Binding ClearShapeCommand}"
                                                                FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Remove the drawn shape: the train is placed as a box along the platform edge." />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="File" />
                                <TextBlock Text="{Binding FileText}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Margin="12,18,12,0" Style="{StaticResource DimText}"
                                       Text="Fields commit when they lose focus; every edit can be undone with Ctrl+Z." />
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- CHECK (round 016, D-271, D-272): every rule's findings; outside the edit lock so it reads while running. -->
                <Grid Grid.Row="1" Margin="10,0,10,10" Visibility="{Binding IsCheckTab, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="RUN CHECK" Command="{Binding RunCheckCommand}" Padding="6,0" Margin="0,0,8,0"
                                    FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Run every rule again (F7): model, routes, capacity, gaps." />
                            <ToggleButton Style="{StaticResource ChipToggle}" Content="ALL" IsChecked="{Binding IsCheckAll, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource ChipToggle}" Content="ERRORS" IsChecked="{Binding IsCheckErrors, Mode=TwoWay}" ToolTip="The study can't run until these are fixed." />
                            <ToggleButton Style="{StaticResource ChipToggle}" Content="WARNINGS" IsChecked="{Binding IsCheckWarnings, Mode=TwoWay}" ToolTip="Probably not what you meant; it still runs." />
                            <ToggleButton Style="{StaticResource ChipToggle}" Content="INFO" IsChecked="{Binding IsCheckInfo, Mode=TwoWay}" ToolTip="Useful to know: capacity, Level of Service." />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}" Content="Show ignored" IsChecked="{Binding ShowIgnoredFindings, Mode=TwoWay}" Margin="0,0,0,4"
                                      ToolTip="Ignored findings stay ignored for this study (saved with it) until you UNIGNORE them." />
                        <TextBlock Margin="2,0,2,6" Style="{StaticResource DimText}" TextWrapping="Wrap" Text="{Binding CheckSummary}" />
                        <!-- Out of date (round 017, D-295): CHECK stays on demand. -->
                        <TextBlock Margin="2,0,2,6" TextWrapping="Wrap" Foreground="{StaticResource YellowBrush}" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                   Text="OUT OF DATE ▸ the study changed since this CHECK. Press RUN CHECK (F7) again."
                                   Visibility="{Binding IsCheckStale, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CheckRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="6,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PanelAltBrush}" Cursor="Hand"
                                            ToolTip="Click to go there: plan view on its level, selected and framed.">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoCommand}" />
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="6,0,0,0" Padding="4,0" Content="{Binding IgnoreText}" Command="{Binding ToggleIgnoreCommand}"
                                                    FontFamily="{DynamicResource RetroFont}" FontSize="13" ToolTip="Ignore this finding for this study (undoable), or bring it back." />
                                            <TextBlock DockPanel.Dock="Left" Width="44" Text="{Binding SeverityText}" FontFamily="{DynamicResource RetroFont}" FontSize="15" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RuleText}" Style="{StaticResource DimText}" FontSize="11" />
                                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- RESULTS (D-219): outside the edit-locked scroller, so it works while running. Device stats after the
                     warm-up (D-218), the hand-drawn graph (D-220, D-221, D-226) and CSV export (D-222). -->
                <Grid Grid.Row="1" Margin="10,0,10,10" Visibility="{Binding IsResultsTab, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Table chips (D-232) and the summary line for the table showing. -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="TABLE" Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="{DynamicResource RetroFont}" FontSize="15" Foreground="{StaticResource TextDimBrush}" />
                            <ToggleButton Style="{StaticResource ChipToggle}" Content="DEVICES" IsChecked="{Binding IsTableDevices, Mode=TwoWay}" ToolTip="Served, waits, queues and utilisation per device, after the warm-up." />
                            <ToggleButton Style="{StaticResource ChipToggle}" Content="ZONES" IsChecked="{Binding IsTableZones, Mode=TwoWay}" ToolTip="Occupancy and flow through each measurement zone, after the warm-up." />
                            <ToggleButton Style="{StaticResource ChipToggle}" Content="JOURNEYS" IsChecked="{Binding IsTableJourneys, Mode=TwoWay}" ToolTip="Journey times per profile and journey, for people spawned after the warm-up." />
                            <ToggleButton Style="{StaticResource ChipToggle}" Content="LIFTS" IsChecked="{Binding IsTableLifts, Mode=TwoWay}" ToolTip="Boardings, landing waits, rides and give-ups per lift bank, after the warm-up." />
                        </StackPanel>
                        <TextBlock Margin="2,0,2,6" Style="{StaticResource DimText}" TextWrapping="Wrap" Text="{Binding ResultsSummary}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" Style="{StaticResource ResultsGrid}" ItemsSource="{Binding ResultRows}"
                              Visibility="{Binding IsTableDevices, Converter={StaticResource BoolToVis}}"
                              SelectedItem="{Binding SelectedResultRow, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="▸" SortMemberPath="IsGraphed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsGraphed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                  ToolTip="Show this device's queue on the graph (QUEUES). With none ticked, the five longest show." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DEVICE" Binding="{Binding Name}" IsReadOnly="True" />
                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" IsReadOnly="True" />
                            <DataGridTextColumn Header="SERVED" Binding="{Binding Served}" IsReadOnly="True" />
                            <DataGridTextColumn Header="MEAN S" Binding="{Binding MeanWaitS, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="95% S" Binding="{Binding P95WaitS, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="MAX S" Binding="{Binding MaxWaitS, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="MAX Q" Binding="{Binding MaxQueue}" IsReadOnly="True" />
                            <DataGridTextColumn Header="UTIL %" Binding="{Binding UtilisationPct, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="BALK" Binding="{Binding Balked}" IsReadOnly="True" />
                            <DataGridTextColumn Header="GAVE UP" Binding="{Binding GaveUp}" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ZONES (D-228): measurement zone occupancy and flow; tick ▸ to graph a zone. -->
                    <DataGrid Grid.Row="1" Style="{StaticResource ResultsGrid}" ItemsSource="{Binding ZoneResultRows}"
                              Visibility="{Binding IsTableZones, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="▸" SortMemberPath="IsGraphed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsGraphed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                  ToolTip="Show this zone's occupancy on the graph (ZONES). With none ticked, every zone shows." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ZONE" Binding="{Binding Name}" IsReadOnly="True" />
                            <DataGridTextColumn Header="PEAK" Binding="{Binding PeakOccupancy}" IsReadOnly="True" />
                            <DataGridTextColumn Header="MEAN" Binding="{Binding MeanOccupancy, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="PEAK P/M²" Binding="{Binding PeakDensity, StringFormat={}{0:0.00}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="ENTRIES" Binding="{Binding Entries}" IsReadOnly="True" />
                            <DataGridTextColumn Header="/ MIN" Binding="{Binding EntriesPerMin, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="/ MIN / M" Binding="{Binding EntriesPerMinPerM, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="WIDTH M" Binding="{Binding WidthM, StringFormat={}{0:0.00}}" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- JOURNEYS (D-229, D-230): profile × journey, people spawned after the warm-up. -->
                    <DataGrid Grid.Row="1" Style="{StaticResource ResultsGrid}" ItemsSource="{Binding JourneyResultRows}"
                              Visibility="{Binding IsTableJourneys, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROFILE" Binding="{Binding Profile}" IsReadOnly="True" />
                            <DataGridTextColumn Header="JOURNEY" Binding="{Binding Journey}" IsReadOnly="True" />
                            <DataGridTextColumn Header="DONE" Binding="{Binding Finished}" IsReadOnly="True" />
                            <DataGridTextColumn Header="MEAN S" Binding="{Binding MeanS, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="95% S" Binding="{Binding P95S, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="OK S" Binding="{Binding AcceptableS, StringFormat={}{0:0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="WITHIN %" Binding="{Binding WithinPct, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="LONG WAIT %" Binding="{Binding LongWaitPct, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="GAVE UP" Binding="{Binding GaveUp}" IsReadOnly="True" />
                            <DataGridTextColumn Header="STUCK" Binding="{Binding Stuck}" IsReadOnly="True" />
                            <DataGridTextColumn Header="IN PROGRESS" Binding="{Binding InProgress}" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- LIFTS (D-260): one row per bank; waits on the landing, rides from boarding to getting off. -->
                    <DataGrid Grid.Row="1" Style="{StaticResource ResultsGrid}" ItemsSource="{Binding LiftResultRows}"
                              Visibility="{Binding IsTableLifts, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="LIFT" Binding="{Binding Name}" IsReadOnly="True" />
                            <DataGridTextColumn Header="CARS" Binding="{Binding Cars}" IsReadOnly="True" />
                            <DataGridTextColumn Header="BOARDED" Binding="{Binding Boarded}" IsReadOnly="True" />
                            <DataGridTextColumn Header="MEAN WAIT S" Binding="{Binding MeanWaitS, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="95% S" Binding="{Binding P95WaitS, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="MAX S" Binding="{Binding MaxWaitS, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="RIDES" Binding="{Binding Rides}" IsReadOnly="True" />
                            <DataGridTextColumn Header="MEAN RIDE S" Binding="{Binding MeanRideS, StringFormat={}{0:0.0}}" IsReadOnly="True" />
                            <DataGridTextColumn Header="GAVE UP" Binding="{Binding GaveUp}" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock Text="GRAPH" Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="{DynamicResource RetroFont}" FontSize="15" Foreground="{StaticResource TextDimBrush}" />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="PEOPLE" IsChecked="{Binding IsGraphPeople, Mode=TwoWay}" ToolTip="People in the model over time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="QUEUES" IsChecked="{Binding IsGraphQueues, Mode=TwoWay}" ToolTip="People in line at the ticked devices (or the five longest)." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="DENSITY" IsChecked="{Binding IsGraphDensity, Mode=TwoWay}" ToolTip="Highest density anywhere on the map, over the walkway Level of Service bands." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="FLOW" IsChecked="{Binding IsGraphFlow, Mode=TwoWay}" ToolTip="People arriving and leaving per minute." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="ZONES" IsChecked="{Binding IsGraphZones, Mode=TwoWay}" ToolTip="People in each measurement zone (the ticked ones, or all)." />
                    </StackPanel>

                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <views:TimeSeriesGraph Data="{Binding ResultsGraph}" />
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="EXPORT CSV" Command="{Binding ExportResultsCommand}" Padding="6,0"
                                FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                ToolTip="Write devices.csv, zones.csv, journeys.csv, lifts.csv (stats after the warm-up) and timeseries.csv (every 5 s from the start) into a folder you pick." />
                        <Button Margin="6,0,0,0" Content="EXPORT PNG" Command="{Binding ExportPngCommand}" Padding="6,0"
                                FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                ToolTip="Save the view at twice its size, with the map legend and a title block." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
