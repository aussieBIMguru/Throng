<Window x:Class="Throng.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Throng.App.Views"
        Title="{Binding WindowTitle}"
        Icon="/Assets/throng.ico"
        Width="1440"
        Height="880"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        Window-wide shortcuts. Editing shortcuts (R/P/C/W/T/O/V tools, Ctrl+C/X/V/D/A, Ctrl+Shift+V, Del, Esc,
        Enter, Backspace, Tab) are handled by the viewport when it has focus, so they never fire while typing in a field.
    -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding NewFromDemoCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F2" Command="{Binding PlanViewCommand}" />
        <KeyBinding Key="F3" Command="{Binding OrbitViewCommand}" />
        <KeyBinding Key="Home" Command="{Binding ZoomExtentsCommand}" />
        <KeyBinding Key="F7" Command="{Binding ValidateCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ===== Menu ===== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand}" />
                <MenuItem Header="New from _Demo" InputGestureText="Ctrl+Shift+D" Command="{Binding NewFromDemoCommand}" />
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="{Binding UndoHeader}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="{Binding RedoHeader}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding CutCommand}" />
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
                <MenuItem Header="_Paste in Place" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
                <MenuItem Header="D_uplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}" />
                <MenuItem Header="Copy to _Levels…" InputGestureText="Ctrl+Shift+V" Command="{Binding CopyToLevelsCommand}" />
                <MenuItem Header="_Delete" InputGestureText="Del" Command="{Binding DeleteCommand}" />
                <Separator />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Plan" InputGestureText="F2" Command="{Binding PlanViewCommand}" />
                <MenuItem Header="_3D Orbit" InputGestureText="F3" Command="{Binding OrbitViewCommand}" />
                <Separator />
                <MenuItem Header="_Zoom Extents" InputGestureText="Home" Command="{Binding ZoomExtentsCommand}" />
                <Separator />
                <MenuItem Header="_Hide Selection" InputGestureText="H" Command="{Binding HideSelectionCommand}" />
                <MenuItem Header="_Isolate Selection" InputGestureText="I" Command="{Binding IsolateSelectionCommand}" />
                <MenuItem Header="_Reset View" InputGestureText="Esc" Command="{Binding ResetViewCommand}" />
            </MenuItem>
            <MenuItem Header="_Draw">
                <MenuItem Header="_Select" InputGestureText="V" Command="{Binding SetToolCommand}" CommandParameter="Select" />
                <Separator />
                <MenuItem Header="_Rectangle" InputGestureText="R" Command="{Binding SetToolCommand}" CommandParameter="Rectangle" />
                <MenuItem Header="_Polygon" InputGestureText="P" Command="{Binding SetToolCommand}" CommandParameter="Polygon" />
                <MenuItem Header="_Circle" InputGestureText="C" Command="{Binding SetToolCommand}" CommandParameter="Circle" />
                <MenuItem Header="_Wall" InputGestureText="W" Command="{Binding SetToolCommand}" CommandParameter="Wall" />
                <Separator />
                <MenuItem Header="Co_nnect (stair, escalator, ramp)" InputGestureText="T" Command="{Binding SetToolCommand}" CommandParameter="Connect" />
                <MenuItem Header="S_haft" InputGestureText="O" Command="{Binding SetToolCommand}" CommandParameter="Shaft" />
                <MenuItem Header="Place _device / travelator" InputGestureText="D" Command="{Binding SetToolCommand}" CommandParameter="Place" />
            </MenuItem>
            <MenuItem Header="_Study">
                <MenuItem Header="_Validate" InputGestureText="F7" Command="{Binding ValidateCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Throng" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- ===== Toolbar ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="6,5">
            <DockPanel>
                <!-- Brand block on the right. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0">
                    <Image Source="/Assets/throng-64.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="THRONG" FontFamily="{DynamicResource RetroFont}" FontSize="30" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="PEDESTRIAN FLOW LAB" FontFamily="{DynamicResource RetroFont}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="1,-4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE710;" Content="NEW" Command="{Binding NewCommand}" ToolTip="New study. A blank slate and a single ground level." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE8F1;" Content="DEMO" Command="{Binding NewFromDemoCommand}" ToolTip="Load the Interchange Station demo: three levels of commuters-to-be (Ctrl+Shift+D)." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE8E5;" Content="OPEN" Command="{Binding OpenCommand}" ToolTip="Open a .throng study." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE74E;" Content="SAVE" Command="{Binding SaveCommand}" ToolTip="Save the study. Your crowd thanks you." />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE7A7;" Content="UNDO" Command="{Binding UndoCommand}" ToolTip="Undo the last change." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE7A6;" Content="REDO" Command="{Binding RedoCommand}" ToolTip="Redo." />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Content="PLAN" Tag="&#xE80A;" Command="{Binding PlanViewCommand}" ToolTip="Plan view of the active level (F2). This is where you draw.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlanView}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="3D" Tag="&#xE81E;" Command="{Binding OrbitViewCommand}" ToolTip="3D orbit of every visible level (F3).">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrbitView}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE740;" Content="FIT" Command="{Binding ZoomExtentsCommand}" ToolTip="Zoom extents (Home)." />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE73E;" Content="CHECK" Command="{Binding ValidateCommand}" ToolTip="Validate the study (F7). Catches irrational setups before your agents do." />
                    <Border Style="{StaticResource ToolSeparator}" />

                    <!-- RUN (D-097, D-104, D-106): PLAY checks and compiles first; editing is locked until RESET. -->
                    <Button Style="{StaticResource ToolButton}" Tag="{Binding PlayGlyph}" Content="{Binding PlayText}" Command="{Binding PlayPauseCommand}"
                            ToolTip="Run or pause the study. The first PLAY checks it and builds the navigation; editing is locked until RESET." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE893;" Content="STEP" Command="{Binding StepCommand}" ToolTip="Pause and advance one 0.1 s step." />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE72C;" Content="RESET" Command="{Binding ResetRunCommand}" ToolTip="End the run, clear the agents and unlock editing." />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="×½" IsChecked="{Binding IsSpeedHalf, Mode=TwoWay}" ToolTip="Half real time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="×1" IsChecked="{Binding IsSpeed1, Mode=TwoWay}" ToolTip="Real time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="×2" IsChecked="{Binding IsSpeed2, Mode=TwoWay}" ToolTip="Twice real time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="×4" IsChecked="{Binding IsSpeed4, Mode=TwoWay}" ToolTip="Four times real time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="×8" IsChecked="{Binding IsSpeed8, Mode=TwoWay}" ToolTip="Eight times real time." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="MAX" IsChecked="{Binding IsSpeedMax, Mode=TwoWay}" ToolTip="As fast as the machine allows." />
                    </StackPanel>
                    <!-- COLOUR (D-146): profile colours or a stress ramp; works while paused. Stuck people always blink a red ring. -->
                    <Border Style="{StaticResource ToolSeparator}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="PROFILE" IsChecked="{Binding IsColourProfile, Mode=TwoWay}" ToolTip="Colour people by profile (commuter, luggage…)." />
                        <ToggleButton Style="{StaticResource ChipToggle}" Content="STRESS" IsChecked="{Binding IsColourStress, Mode=TwoWay}"
                                      ToolTip="Colour people by stress: blue calm, yellow tense, red fed up. Builds after half their patience is spent held up below half speed." />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Draw strip: tools, new-shape kind, snaps (plan view, D-026) ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4"
                IsEnabled="{Binding IsEditable}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="DRAW" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE8B3;" Content="SELECT" IsChecked="{Binding IsSelectTool, Mode=TwoWay}" ToolTip="Select, box-select, move and reshape (V)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE739;" Content="RECT" IsChecked="{Binding IsRectangleTool, Mode=TwoWay}" ToolTip="Rectangle: two corners or a drag. Type W,H for an exact size (R)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE70F;" Content="POLY" IsChecked="{Binding IsPolygonTool, Mode=TwoWay}" ToolTip="Polygon: click points; Enter, double-click or the first point closes (P)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xEA3A;" Content="CIRCLE" IsChecked="{Binding IsCircleTool, Mode=TwoWay}" ToolTip="Circle: centre then radius. Stored as a polygon within 50 mm of true (C)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE76F;" Content="WALL" IsChecked="{Binding IsWallTool, Mode=TwoWay}" ToolTip="Wall: an open polyline with thickness. Enter or double-click finishes (W)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE70E;" Content="CONNECT" IsChecked="{Binding IsConnectTool, Mode=TwoWay}"
                              ToolTip="Stair, escalator or ramp to a level above: click the bottom landing, aim up the run, click. Tab flips a switchback (T)." />
                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE80F;" Content="SHAFT" IsChecked="{Binding IsShaftTool, Mode=TwoWay}"
                              ToolTip="Shaft, atrium or void through several levels: two corners or a drag. Set its base and top in SELECTION (O)." />

                <ToggleButton Style="{StaticResource ChipToggle}" Tag="&#xE8B7;" Content="PLACE" IsChecked="{Binding IsPlaceTool, Mode=TwoWay}"
                              ToolTip="Device or travelator from the library: click its position, aim the service side (travelator: the far end), click (D)." />

                <!-- PLACE options (D-090). -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlaceTool, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="PRESET" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <ComboBox Width="190" VerticalAlignment="Center" ItemsSource="{Binding PlacePresetOptions}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedPlacePreset, Mode=TwoWay}" ToolTip="Device or travelator preset. Double-clicking one in LIBRARY picks it too." />
                </StackPanel>

                <!-- CONNECT options: preset and target level (D-054). -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsConnectTool, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="PRESET" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <ComboBox Width="170" VerticalAlignment="Center" ItemsSource="{Binding ConnectPresetOptions}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedConnectPreset, Mode=TwoWay}" ToolTip="Stair, escalator or ramp preset. Double-clicking one in LIBRARY ▸ VERTICAL picks it too." />
                    <TextBlock Text="TO" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <ComboBox Width="150" VerticalAlignment="Center" ItemsSource="{Binding ConnectTargetOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding ConnectTargetLevelId, Mode=TwoWay}" ToolTip="Level the connector arrives at. It starts on the active level, so pick a level above." />
                </StackPanel>

                <TextBlock Text="AS" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                <ComboBox Width="104" VerticalAlignment="Center" ItemsSource="{Binding DrawKindOptions}" SelectedItem="{Binding DrawKind, Mode=TwoWay}"
                          ToolTip="What new rectangles, polygons and circles become. Walls are always walls." />

                <Border Width="1" Margin="12,4" Background="{StaticResource BorderBrush}" />

                <TextBlock Text="SNAP" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ToggleButton Style="{StaticResource ChipToggle}" Content="GRID" IsChecked="{Binding SnapGrid, Mode=TwoWay}" ToolTip="Snap to the grid step." />
                <ToggleButton Style="{StaticResource ChipToggle}" Content="END" IsChecked="{Binding SnapEndpoint, Mode=TwoWay}" ToolTip="Snap to vertices on this level and the level below." />
                <ToggleButton Style="{StaticResource ChipToggle}" Content="MID" IsChecked="{Binding SnapMidpoint, Mode=TwoWay}" ToolTip="Snap to edge midpoints." />
                <ToggleButton Style="{StaticResource ChipToggle}" Content="ORTHO" IsChecked="{Binding SnapOrtho, Mode=TwoWay}" ToolTip="Lock to horizontal/vertical when close. Hold Shift to force it." />
                <TextBlock Text="STEP" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                <TextBox Width="54" VerticalAlignment="Center" Text="{Binding GridStepM, Mode=TwoWay}" ToolTip="Grid snap step in metres." />
                <TextBlock Text="m" Style="{StaticResource DimDataText}" VerticalAlignment="Center" Margin="4,0,0,0" />

                <!-- Shown only while something is temporarily hidden (D-046). -->
                <Border Width="1" Margin="12,4" Background="{StaticResource BorderBrush}"
                        Visibility="{Binding HasHiddenRegions, Converter={StaticResource BoolToVis}}" />
                <Button Content="{Binding ResetViewText}" Command="{Binding ResetViewCommand}" Padding="8,1"
                        FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource OrangeBrush}"
                        BorderBrush="{StaticResource OrangeBrush}" Focusable="False" VerticalAlignment="Center"
                        Visibility="{Binding HasHiddenRegions, Converter={StaticResource BoolToVis}}"
                        ToolTip="Show everything temporarily hidden again (Esc with nothing selected)." />
            </WrapPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▸ " FontFamily="{DynamicResource RetroFont}" FontSize="17" Foreground="{StaticResource YellowBrush}" />
                    <TextBlock Text="{Binding Ticker}" FontFamily="{DynamicResource RetroFont}" FontSize="17" Foreground="{StaticResource YellowBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Text="{Binding SummaryText}" Style="{StaticResource DimDataText}"
                           Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="2" Margin="16,0,12,0" VerticalAlignment="Center" Text="{Binding RunStatusText}" FontFamily="{DynamicResource RetroFont}" FontSize="17"
                           Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsRunActive, Converter={StaticResource BoolToVis}}"
                           ToolTip="Speed · agents walking · emitted · arrived · mean journey time · in device queues · stressed (stress 0.5 or more) · gave up (patience ran out, left) · stuck (no progress for 30 s; removed after 120 s)." />
                <Border Grid.Column="3" Background="#06090F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,1">
                    <TextBlock Text="{Binding ClockText}" FontFamily="{DynamicResource RetroFont}" FontSize="20" Foreground="{StaticResource GreenBrush}" ToolTip="Study clock: the run's time of day while running, otherwise the start time." />
                </Border>
            </Grid>
        </Border>

        <!-- ===== Body: levels/library | viewport | properties ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="290" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <!-- Add above / below, delete (D-142, D-143); locked while a run is active. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,8,8,0" VerticalAlignment="Center" TextElement.FontSize="11" IsEnabled="{Binding IsEditable}">
                        <Button Padding="6,0" Margin="2,0" Content="+ ABOVE" Command="{Binding AddLevelAboveCommand}"
                                ToolTip="Add a level above the active one. Between two levels it goes at mid-height and nothing moves." />
                        <Button Padding="6,0" Margin="2,0" Content="+ BELOW" Command="{Binding AddLevelBelowCommand}"
                                ToolTip="Add a level below the active one. Between two levels it goes at mid-height and nothing moves." />
                        <Button Padding="6,0" Margin="2,0" Content="DELETE" Command="{Binding DeleteLevelCommand}"
                                ToolTip="Delete the active level and everything on it (asks first; undo brings it back)." />
                    </StackPanel>
                    <TextBlock Style="{StaticResource PanelHeader}" Text="LEVELS" />
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding ActiveLevel, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource EyeToggle}" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1" Style="{StaticResource LockToggle}" IsChecked="{Binding IsLocked, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource DimDataText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Library: category tabs + search over one filtered list (D-021, D-031). -->
                <TextBlock Grid.Row="2" Style="{StaticResource PanelHeader}" Text="LIBRARY" />
                <Grid Grid.Row="3" Margin="10,0,10,6">
                    <TextBox x:Name="LibrarySearch" Text="{Binding Library.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search every category by name, summary or description." />
                    <TextBlock Text="Search library…" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextDisabledBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ListBox Grid.Row="4" Margin="8,0,8,4" Style="{StaticResource TabStrip}"
                         ItemsSource="{Binding Library.Tabs}" SelectedItem="{Binding Library.SelectedTab, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource RetroFont}" FontSize="15" />
                                <TextBlock Text="{Binding CountText}" FontFamily="{DynamicResource RetroFont}" FontSize="13" Margin="4,1,0,0" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsEditable}">
                    <StackPanel Margin="10,2,6,8">
                        <TextBlock Text="{Binding Library.EmptyText}" Style="{StaticResource DimText}" Margin="0,4,0,0"
                                   Visibility="{Binding Library.IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Library.VisibleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" MouseLeftButtonDown="OnLibraryItemMouseDown" MouseMove="OnLibraryItemMouseMove">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#2622D3EE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ToolTip>
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" />
                                                <TextBlock Text="Double-click a device, stair, escalator, ramp or travelator to place it, or drag it onto the plan. Click a journey to see or edit its steps in SELECTION." Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid.ToolTip>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" Margin="0,3,8,0" VerticalAlignment="Top" Background="{Binding Swatch}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Viewport -->
            <views:ViewportView x:Name="Viewport" Grid.Column="2" />

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Right panel: SELECTION / LEVEL / STUDY tabs (D-045). Selecting anything switches to SELECTION. -->
            <Grid Grid.Column="4" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox Margin="10,10,10,6" Style="{StaticResource TabStrip}"
                         ItemsSource="{Binding PropertiesTabs}" SelectedIndex="{Binding PropertiesTabIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{DynamicResource RetroFont}" FontSize="18" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsEditable}">
                    <Grid Margin="0,0,0,12">

                        <!-- SELECTION -->
                        <StackPanel Visibility="{Binding IsSelectionTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="12,2,12,4" Style="{StaticResource DimText}" Text="{Binding SelectionText}" />
                            <Border Visibility="{Binding HasRegionSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedRegion}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Kind" />
                                    <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind, Mode=TwoWay}" IsEnabled="{Binding CanChangeKind}" />
                                    <StackPanel Visibility="{Binding IsZone, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Zone purpose" />
                                        <ComboBox ItemsSource="{Binding ZoneKindOptions}" SelectedItem="{Binding ZoneKind, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Speed factor (Slow zones)" />
                                        <TextBox Text="{Binding SpeedFactor, Mode=TwoWay}" />
                                    </StackPanel>

                                    <!-- Emission rules on spawn zones (D-096, D-099) -->
                                    <StackPanel Visibility="{Binding IsSpawn, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource PanelHeader}" Text="EMISSION RULES" Margin="0,14,0,2" />
                                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Text="No rules yet: this zone emits no one. Add one to send people to a sink."
                                                   Visibility="{Binding HasNoRules, Converter={StaticResource BoolToVis}}" />
                                        <ItemsControl ItemsSource="{Binding EmissionRules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,6,0,0" Padding="8,4,8,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="REMOVE" Command="{Binding RemoveCommand}" Padding="6,0"
                                                                        FontFamily="{DynamicResource RetroFont}" FontSize="14" ToolTip="Delete this rule." />
                                                                <TextBlock Text="{Binding Header}" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Mix (who, their journey and share)" />
                                                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Text="No mix lines: this rule emits no one."
                                                                       Visibility="{Binding HasNoLines, Converter={StaticResource BoolToVis}}" />
                                                            <ItemsControl ItemsSource="{Binding MixLines}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,4,0,0" Padding="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="56" />
                                                                                        <ColumnDefinition Width="44" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                                                              SelectedValue="{Binding ProfileId, Mode=TwoWay}" ToolTip="Agent profile." />
                                                                                    <TextBox Grid.Column="1" Margin="4,0,0,0" Text="{Binding Share, Mode=TwoWay}" ToolTip="Relative share of the rule's arrivals." />
                                                                                    <TextBlock Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource DimText}" Text="{Binding SharePercent}" VerticalAlignment="Center" />
                                                                                    <Button Grid.Column="3" Margin="4,0,0,0" Content="×" Command="{Binding RemoveCommand}" Padding="6,0" ToolTip="Remove this line." />
                                                                                </Grid>
                                                                                <ComboBox Margin="0,2,0,0" ItemsSource="{Binding JourneyOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                                                          SelectedValue="{Binding JourneyId, Mode=TwoWay}" ToolTip="The steps they work through before leaving (LIBRARY ▸ JOURNEYS)." />
                                                                                <TextBox Margin="0,2,0,0" Text="{Binding SpawnTagsText, Mode=TwoWay}"
                                                                                         ToolTip="Tags some of them start with, e.g. &quot;ticket 50%, vip&quot; (no % means everyone). Journey steps can need, skip on or grant tags." />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Content="ADD LINE" Command="{Binding AddLineCommand}"
                                                                    FontFamily="{DynamicResource RetroFont}" FontSize="14" ToolTip="Add a mix line: another profile or journey in this stream." />
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="People per minute" />
                                                            <TextBox Text="{Binding RatePerMinute, Mode=TwoWay}" />
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Spacing" />
                                                            <ComboBox ItemsSource="{Binding PatternOptions}" SelectedItem="{Binding Pattern, Mode=TwoWay}"
                                                                      ToolTip="Constant: evenly spaced. Poisson: random arrivals at the same average rate." />
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Rate curve" />
                                                            <ComboBox ItemsSource="{Binding CurveOptions}" SelectedItem="{Binding CurveName, Mode=TwoWay}"
                                                                      ToolTip="Scales the rate over the run: minutes from the start → multiplier, straight lines between points. Pick a preset, then edit its points." />
                                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding CurveSummary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            <StackPanel Visibility="{Binding HasCurve, Converter={StaticResource BoolToVis}}">
                                                                <Border Margin="0,4,0,0" HorizontalAlignment="Left" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="2">
                                                                    <Polyline Points="{Binding CurveSparkline}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="160" Height="28" />
                                                                </Border>
                                                                <Grid Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Style="{StaticResource DimText}" Text="Minute" />
                                                                    <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="× rate" Margin="4,0,0,0" />
                                                                </Grid>
                                                                <ItemsControl ItemsSource="{Binding CurvePoints}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBox Grid.Column="0" Text="{Binding Minute, Mode=TwoWay}" ToolTip="Minutes from the start of the run." />
                                                                                <TextBox Grid.Column="1" Margin="4,0,0,0" Text="{Binding Multiplier, Mode=TwoWay}" ToolTip="Multiplier on the rule's rate (1 = as entered, 0 = no one)." />
                                                                                <Button Grid.Column="2" Margin="4,0,0,0" Content="×" Command="{Binding RemoveCommand}" Padding="6,0" ToolTip="Remove this point." />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Content="ADD POINT" Command="{Binding AddPointCommand}"
                                                                    FontFamily="{DynamicResource RetroFont}" FontSize="14" ToolTip="Add a curve point 10 minutes after the last, at the same multiplier." />
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Going to" />
                                                            <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding DestinationMode, Mode=TwoWay}"
                                                                      ToolTip="NearestSink: the quickest sink (never this zone). ChosenSinks: the ticked sinks, picked by weight." />
                                                            <StackPanel Visibility="{Binding IsChosenSinks, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Sinks and weights" />
                                                                <TextBlock Style="{StaticResource DimText}" Text="There are no other sink zones." Visibility="{Binding HasNoSinks, Converter={StaticResource BoolToVis}}" />
                                                                <ItemsControl ItemsSource="{Binding Sinks}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <DockPanel Margin="0,2">
                                                                                <TextBox DockPanel.Dock="Right" Width="48" Text="{Binding Weight, Mode=TwoWay}" IsEnabled="{Binding IsOn}"
                                                                                         ToolTip="Relative weight: 2 is picked twice as often as 1." />
                                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center" />
                                                                            </DockPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="ADD RULE" Command="{Binding AddRuleCommand}"
                                                FontFamily="{DynamicResource RetroFont}" FontSize="16"
                                                ToolTip="Add a stream of people: 10 a minute, random arrivals, to the nearest sink." />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasHeight, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Height" />
                                        <ComboBox ItemsSource="{Binding HeightModeOptions}" SelectedItem="{Binding HeightMode, Mode=TwoWay}"
                                                  ToolTip="Fixed: metres above each level's floor. FullStorey: floor to the next level's floor (D-077)." />
                                        <StackPanel Visibility="{Binding IsFixedHeight, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Height (m)" />
                                            <TextBox Text="{Binding HeightM, Mode=TwoWay}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding StoreyHeightText}" Style="{StaticResource DimDataText}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Top level" />
                                        <ComboBox ItemsSource="{Binding TopLevelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TopLevelId, Mode=TwoWay}"
                                                  ToolTip="Spans from this level up to the chosen one. Fixed heights repeat on each level; full storey runs floor to floor (D-079)." />
                                        <StackPanel Visibility="{Binding HasLevelToggles, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="On these levels" />
                                            <ItemsControl ItemsSource="{Binding LevelToggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsWall, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Thickness (m)" />
                                        <TextBox Text="{Binding ThicknessM, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tag (Void = floor opening)" />
                                    <TextBox Text="{Binding Tag, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource DataText}" />
                                        <TextBlock Text="  ·  " Style="{StaticResource DimDataText}" />
                                        <TextBlock Text="{Binding VertexText}" Style="{StaticResource DimDataText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Connector (D-063) -->
                            <Border Visibility="{Binding HasConnectorSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedConnector}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Preset" />
                                    <TextBlock Text="{Binding PresetText}" Style="{StaticResource DataText}" />
                                    <StackPanel Visibility="{Binding ChangesLevel, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Bottom level" />
                                        <ComboBox ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BottomLevelId, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Top level" />
                                        <ComboBox ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TopLevelId, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsTravelator, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Belt length (m)" />
                                        <TextBox Text="{Binding RunLengthM, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Width (m)" />
                                    <TextBox Text="{Binding WidthM, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Direction" />
                                    <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding Direction, Mode=TwoWay}" />
                                    <StackPanel Visibility="{Binding CanChangeShape, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Shape" />
                                        <ComboBox ItemsSource="{Binding ShapeOptions}" SelectedItem="{Binding Shape, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsSwitchback, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Return run side (Tab flips)" />
                                        <ComboBox ItemsSource="{Binding SideOptions}" SelectedItem="{Binding ReturnSide, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Gap between runs (m)" />
                                        <TextBox Text="{Binding SwitchbackGapM, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowsPerLevelOption, Converter={StaticResource BoolToVis}}">
                                        <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,12,0,0" Content="One circuit per level" IsChecked="{Binding PerLevelCircuits, Mode=TwoWay}"
                                                      ToolTip="On: a stacked stair core, one switchback per storey at the same spot. Off: one long run from bottom to top (D-091)." />
                                        <StackPanel Visibility="{Binding HasExitToggles, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Exits at intermediate levels" />
                                            <ItemsControl ItemsSource="{Binding ExitToggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,12,0,0" Content="Staff only" IsChecked="{Binding StaffOnly, Mode=TwoWay}"
                                                  ToolTip="Public agents never use it; staff routes arrive in M3 (D-110)." />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Run angle (°)" />
                                    <TextBox Text="{Binding AngleDeg, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Opening clearance (m)" />
                                    <TextBox Text="{Binding ClearanceM, Mode=TwoWay}"
                                             ToolTip="Extra floor cut around the linked opening on the upper level, for a balustrade (D-065)." />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding LayoutText}" Style="{StaticResource DataText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RiseText}" Style="{StaticResource DimDataText}" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding PairText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Shaft (D-056) -->
                            <Border Visibility="{Binding HasShaftSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedShaft}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Base level" />
                                    <ComboBox ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BaseLevelId, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Top level" />
                                    <ComboBox ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TopLevelId, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tag (e.g. Lift, Atrium)" />
                                    <TextBox Text="{Binding Tag, Mode=TwoWay}" />
                                    <StackPanel Visibility="{Binding HasStopToggles, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lift stops here" />
                                        <ItemsControl ItemsSource="{Binding StopToggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding SizeText}" Style="{StaticResource DataText}" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                               Text="Cut from the walkable area of every level from base to top, including levels with no stop. Grips and edge arrows reshape it on any of those levels." />
                                </StackPanel>
                            </Border>

                            <!-- Device (D-089) -->
                            <Border Visibility="{Binding HasDeviceSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedDevice}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Preset" />
                                    <TextBlock Text="{Binding PresetText}" Style="{StaticResource DataText}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Width (m)" />
                                    <TextBox Text="{Binding WidthM, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Depth (m)" />
                                    <TextBox Text="{Binding DepthM, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Lanes / servers" />
                                    <TextBox Text="{Binding Lanes, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Service side faces (°)" />
                                    <TextBox Text="{Binding AngleDeg, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Height (m)" />
                                    <TextBox Text="{Binding HeightM, Mode=TwoWay}" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding FlowText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />

                                    <!-- Queue (D-153, D-163, D-164) -->
                                    <TextBlock Style="{StaticResource PanelHeader}" Text="QUEUE" Margin="0,14,0,2" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Max queue per lane" />
                                    <TextBox Text="{Binding MaxQueue, Mode=TwoWay}" ToolTip="Longest line per lane or server, in people. A drawn snake holds this many per lane it feeds." />
                                    <StackPanel Visibility="{Binding IsPassThrough, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lane directions (both / front / back, one per lane)" />
                                        <TextBox Text="{Binding LaneDirectionsText, Mode=TwoWay}"
                                                 ToolTip="front = entered from the side the device faces; back = from the other side; both = either way, turning round when empty. e.g. back, back, front, front." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="DRAW QUEUE" Command="{Binding DrawQueueCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Draw the queue path from the service side, click by click; Enter or double-click finishes, Esc cancels. One shared snake feeds every lane." />
                                        <Button Margin="6,0,0,0" Content="CLEAR QUEUE" Command="{Binding ClearQueueCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding HasDrawnQueue, Converter={StaticResource BoolToVis}}" ToolTip="Back to the automatic lines." />
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding QueueText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                               Text="The faint dots in plan are where people stand in line." />
                                </StackPanel>
                            </Border>

                            <!-- Journey from LIBRARY ▸ JOURNEYS (D-154, D-161, D-162, D-165) -->
                            <Border Visibility="{Binding HasJourneySelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedJourney}">
                                    <TextBlock Style="{StaticResource PanelHeader}" Text="JOURNEY" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="DUPLICATE" Command="{Binding DuplicateCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                ToolTip="Make an editable copy in this study (new name and key)." />
                                        <Button Margin="6,0,0,0" Content="DELETE" Command="{Binding DeleteCommand}" Padding="6,0" FontFamily="{DynamicResource RetroFont}" FontSize="15"
                                                Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" ToolTip="Delete this journey (only when no mix line uses it)." />
                                    </StackPanel>
                                    <StackPanel IsEnabled="{Binding IsEditable}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                                        <TextBox Text="{Binding Description, Mode=TwoWay}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Steps (in order; steps whose tags don't match are skipped)" />
                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,4,0,0" Padding="6,4,6,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding NumberText}" FontFamily="{DynamicResource RetroFont}" FontSize="16" Foreground="{StaticResource AccentBrush}"
                                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                          SelectedValue="{Binding Kind, Mode=TwoWay}" ToolTip="What this step asks people to do." />
                                                                <Button Grid.Column="2" Margin="4,0,0,0" Content="▲" Command="{Binding MoveUpCommand}" Padding="5,0" ToolTip="Move up." />
                                                                <Button Grid.Column="3" Margin="2,0,0,0" Content="▼" Command="{Binding MoveDownCommand}" Padding="5,0" ToolTip="Move down." />
                                                                <Button Grid.Column="4" Margin="2,0,0,0" Content="×" Command="{Binding RemoveCommand}" Padding="6,0" ToolTip="Remove this step." />
                                                            </Grid>
                                                            <StackPanel Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding TargetLabel}" />
                                                                <ComboBox IsEditable="True" ItemsSource="{Binding TargetOptions}" Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                          ToolTip="Device steps: a device type tag (Gate, TicketMachine…). Zone steps: a zone tag (Retail…), empty for any." />
                                                                <TextBlock Text="{Binding PinnedText}" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                                                           Visibility="{Binding HasPinned, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                            <StackPanel Visibility="{Binding IsDwell, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Dwell (s, e.g. 60 or 30-180)" />
                                                                <TextBox Text="{Binding DwellText, Mode=TwoWay}" />
                                                            </StackPanel>
                                                            <Grid Margin="0,2,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Needs tag" />
                                                                    <TextBox Text="{Binding NeedsTag, Mode=TwoWay}" ToolTip="Only people with this tag do the step (empty = everyone)." />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Lacks tag" />
                                                                    <TextBox Text="{Binding LacksTag, Mode=TwoWay}" ToolTip="Only people without this tag do the step, e.g. ticket at a ticket machine." />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Grants tag" />
                                                                    <TextBox Text="{Binding GrantsTag, Mode=TwoWay}" ToolTip="Tag given when the step is done, e.g. ticket." />
                                                                </StackPanel>
                                                            </Grid>
                                                            <StackPanel Visibility="{Binding IsDevice, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource FieldLabel}" Text="If patience runs out in the queue" />
                                                                <ComboBox ItemsSource="{Binding GiveUpOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GiveUp, Mode=TwoWay}"
                                                                          ToolTip="Patience is the profile's (Commuter 180 s). Keep waiting: stress only. Leave: walk out, counted as gave up. Jump: carry on from another step." />
                                                                <StackPanel Visibility="{Binding IsJump, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Jump to step" />
                                                                    <TextBox Text="{Binding GiveUpStepNumber, Mode=TwoWay}" ToolTip="Step number to carry on from (no tag is granted)." />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="ADD STEP" Command="{Binding AddStepCommand}"
                                                FontFamily="{DynamicResource RetroFont}" FontSize="14" ToolTip="Add a device step before the exit." />
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding Summary}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding UsageText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Underlay (D-083–D-085) -->
                            <Border Visibility="{Binding HasUnderlaySelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0" DataContext="{Binding SelectedUnderlay}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <Button Margin="0,10,0,0" Content="SET SCALE" Command="{Binding SetScaleCommand}" FontFamily="{DynamicResource RetroFont}" FontSize="16"
                                            ToolTip="Click two points on the image a known distance apart, then type that distance (D-084)." />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Width (m)" />
                                    <TextBox Text="{Binding WidthM, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Rotation (°)" />
                                    <TextBox Text="{Binding AngleDeg, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Opacity (0–1)" />
                                    <TextBox Text="{Binding Opacity, Mode=TwoWay}" />
                                    <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,12,0,0" Content="Locked" IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                                  ToolTip="Locked underlays can't be picked, moved or rotated, so you can draw over them." />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding ScaleText}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                               Text="Drag to move, round grip to rotate. Lock it once it lines up. Plan view only." />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="12,14,12,0" Style="{StaticResource DimText}"
                                       Text="H hides the selection, I isolates it; Esc with nothing selected shows everything again. Hiding is view-only. Ctrl+Shift+V copies the selection to other levels." />
                        </StackPanel>

                        <!-- LEVEL (visibility is the eye on each level row, D-050) -->
                        <StackPanel Visibility="{Binding IsLevelTab, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="12,0" DataContext="{Binding ActiveLevel}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Elevation (m)" />
                                <TextBox Text="{Binding ElevationM, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Floor-to-floor height (m)" />
                                <TextBox Text="{Binding HeightM, Mode=TwoWay}" />
                                <ToggleButton Style="{StaticResource SwitchToggle}" Margin="0,12,0,0" Content="Locked" IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                              ToolTip="Locked levels can't be selected or edited, but still give snap points." />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource DimDataText}" Text="{Binding Summary}" />
                            </StackPanel>
                            <TextBlock Margin="12,4,12,0" Style="{StaticResource DataText}" Foreground="{StaticResource GreenBrush}" Text="{Binding WalkableAreaText}"
                                       ToolTip="Union of walkable regions minus obstacles and walls; drawn as the green outline in plan." />

                            <!-- Underlays on this level (D-085) -->
                            <TextBlock Style="{StaticResource PanelHeader}" Text="UNDERLAYS" Margin="12,16,12,4" />
                            <ItemsControl Margin="12,0" ItemsSource="{Binding UnderlayRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Style="{StaticResource EyeToggle}" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <ToggleButton Grid.Column="1" Style="{StaticResource LockToggle}" IsChecked="{Binding IsLocked, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                            <Button Grid.Column="2" Margin="8,0,0,0" Padding="6,1" HorizontalContentAlignment="Left" Content="{Binding Name}" Command="{Binding SelectCommand}"
                                                    ToolTip="Select it (unlock it first if it's locked)." />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="12,2,12,0" Style="{StaticResource DimText}" Text="No underlays on this level."
                                       Visibility="{Binding HasNoUnderlays, Converter={StaticResource BoolToVis}}" />
                            <Button Margin="12,8,12,0" HorizontalAlignment="Left" Content="ADD IMAGE…" Command="{Binding AddUnderlayCommand}"
                                    FontFamily="{DynamicResource RetroFont}" FontSize="16"
                                    ToolTip="Add a PNG or JPEG plan to this level. It's stored inside the .throng file." />

                            <TextBlock Margin="12,14,12,0" Style="{StaticResource DimText}"
                                       Text="Show or hide a level with the eye on its row in LEVELS." />
                        </StackPanel>

                        <!-- STUDY -->
                        <StackPanel Visibility="{Binding IsStudyTab, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="12,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                <TextBox Text="{Binding StudyName, Mode=TwoWay}" />

                                <!-- RUN (D-103, D-105) -->
                                <TextBlock Style="{StaticResource PanelHeader}" Text="RUN" Margin="0,14,0,0" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Start time (24 h)" />
                                <TextBox Text="{Binding StartTimeText, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="End" />
                                <ComboBox ItemsSource="{Binding EndConditionOptions}" SelectedItem="{Binding EndCondition, Mode=TwoWay}"
                                          ToolTip="FixedDuration: pause at the end of the duration. Indefinite: run until you pause or reset." />
                                <StackPanel Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Duration (minutes)" />
                                    <TextBox Text="{Binding DurationMinutes, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Random seed" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6,0" Content="RE-ROLL" Command="{Binding ReRollSeedCommand}"
                                            FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Pick a new random seed: same study, a different crowd." />
                                    <TextBox Text="{Binding Seed, Mode=TwoWay}" ToolTip="Same file + same seed = the same run." />
                                </DockPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Keep side" />
                                <ComboBox ItemsSource="{Binding KeepSideOptions}" SelectedItem="{Binding KeepSide, Mode=TwoWay}"
                                          ToolTip="Which side people drift to when meeting oncoming flows. Escalators: stand on this side, walk on the other." />

                                <!-- TRAINS (D-184-D-187): door zones driven by a timetable. -->
                                <TextBlock Style="{StaticResource PanelHeader}" Text="TRAINS" Margin="0,14,0,0" />
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                           Text="Select door zones (sink or spawn/sink) in the plan, then ADD SERVICE. A door's emission rules say who gets off (their rates are relative shares); it only takes boarders while a train is in." />
                                <Button Margin="0,6,0,0" HorizontalAlignment="Left" Padding="6,0" Content="ADD SERVICE" Command="{Binding AddTrainServiceCommand}"
                                        FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="New train service whose doors are the selected sink zones." />
                                <ItemsControl ItemsSource="{Binding TrainServiceRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,8,0,0" Padding="6,4,6,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="DELETE" Command="{Binding DeleteCommand}" Padding="6,0"
                                                                FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Delete this train service." />
                                                        <TextBlock Text="{Binding Header}" Style="{StaticResource PanelHeader}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tag (Board train steps ask for it)" />
                                                    <TextBox Text="{Binding Tag, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Every (s)" />
                                                    <TextBox Text="{Binding HeadwayText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="First train at (s after the start)" />
                                                    <TextBox Text="{Binding OffsetText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Doors open (s)" />
                                                    <TextBox Text="{Binding DwellText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="People getting off per train" />
                                                    <TextBox Text="{Binding AlightText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Getting off takes (s)" />
                                                    <TextBox Text="{Binding AlightOverText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Places per train" />
                                                    <TextBox Text="{Binding CapacityText, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Doors" />
                                                    <TextBlock Text="{Binding DoorsText}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                                                    <Button Margin="0,4,0,0" HorizontalAlignment="Left" Padding="6,0" Content="SET DOORS" Command="{Binding SetDoorsCommand}"
                                                            FontFamily="{DynamicResource RetroFont}" FontSize="15" ToolTip="Make the sink zones selected in the plan this service's doors." />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="File" />
                                <TextBlock Text="{Binding FileText}" Style="{StaticResource DimDataText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Margin="12,18,12,0" Style="{StaticResource DimText}"
                                       Text="Fields commit when they lose focus; every edit can be undone with Ctrl+Z." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
